#!/usr/bin/env bash
# lsrecent — recency-grouped listing, at directory or repository level, with a
# per-directory ls override and an fzf picker.
#
# Listing:
#   lsrecent [dir]           Grouped listing of dir (default: .). A directory
#                            that merely groups repositories is listed as
#                            repositories; a repo is listed by its children.
#   lsrecent repos [root]    Grouped listing of every git repo under root,
#                            shown at repo level (topic/repo), newest first
#   lsrecent today [root]    Only the repos opened today
#   lsrecent yesterday [root]
#                            Only the repos whose last visit was yesterday. One
#                            opened today as well belongs to today, not here.
#   lsrecent pick [root]     fzf picker over repos; prints the chosen path
#                            (use the `lsrp` / `lsrt` / `lsry` functions to cd)
#
# Choosing an entry. Repo listings are numbered in recency order — 1 is the most
# recently touched — and end with a prompt: type a number, press enter, and you
# are in that repo. Enter on its own (or q, or ctrl-d) stays put. Because a
# process cannot cd its parent shell, the chosen path is written to
# $LSRECENT_CD_FILE and the shell function that set it does the cd; the numbers
# are also bound as shell functions, so they keep working after the prompt is
# gone. LSRECENT_PROMPT=0 suppresses the prompt (listing only, as before), and
# `lsrecent path N` resolves a number to its path.
#
# The prompt is also a browser, so the screenful is never the limit of what you
# can reach from it:
#   23        cd into entry 23 — numbers are the ranking, not the page
#   text      search labels and paths, case-insensitive; a bare word is a search
#   /         clear the search, back to the full ranking
#   +         next page                 -   back to the top of this view
#   a         everything in this view, unpaged
#   ?         the same summary          enter, q, ctrl-d   stay put
#
# The prompt needs the shell half of the pair to be current: shell-init exports
# LSRECENT_SHELL with its version, and a listing that finds it missing or older
# than this binary says so instead of prompting. A shell that was open across an
# upgrade is still running the functions it eval'd at startup — `source ~/.bashrc`
# replaces them. `lsrecent --version` reports both halves.
#
# Repo listings stop at one screenful, oldest cut first, and say how many they
# elided — but the elided repos are numbered too, the footer gives their range,
# and the prompt can page or search into them, so a number past the fold still cds. `--all` (`-a`) prints everything;
# $LSRECENT_MAX_ROWS overrides the row budget (0 = unlimited). A redirected or
# piped listing is never truncated.
#
# Override management (the "micro-backend"):
#   lsrecent add [dir]       Enable the plain-`ls` override for dir (default: .)
#   lsrecent remove [dir]    Disable the override for dir (default: .)
#   lsrecent list            Show all directories with the override enabled
#   lsrecent check [dir]     Exit 0 if dir has the override enabled (quiet;
#                            used by the ls wrapper)
#   lsrecent edit            Open the include-list in $EDITOR
#   lsrecent gui             Same list in a window (needs the lsrecent-gui
#                            companion; also in the app launcher)
#
# Visit log (what "opened" means):
#   lsrecent visit [dir]     Record a visit to dir (the shell hook does this
#                            inline; this is the fallback for other shells)
#   lsrecent prune           Compact the visit log
#
# Shell integration:
#   lsrecent shell-init      Print the bash integration. Add to ~/.bashrc:
#                                eval "$(lsrecent shell-init)"
#
# Config lives in ${XDG_CONFIG_HOME:-~/.config}/lsrecent/dirs — one absolute
# path per line. The visit log lives in
# ${XDG_DATA_HOME:-~/.local/share}/lsrecent/opened.log — "<epoch>\t<path>", and
# the last listing's numbering in .../lsrecent/last-list — "<n>\t<path>".
#
# Repo root defaults to $LSRECENT_REPO_ROOT, else ~/repos/github, else ~/repos.
# Search depth defaults to $LSRECENT_REPO_DEPTH (4).

VERSION="1.7.0"

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/lsrecent"
config="$config_dir/dirs"
state_dir="${XDG_DATA_HOME:-$HOME/.local/share}/lsrecent"
visit_log="$state_dir/opened.log"
sel_map="$state_dir/last-list"

# Whether the listing is bound for a terminal. Has to be sampled here, at the top
# level: inside a $(...) substitution stdout is the pipe bash set up to capture
# the output, so `[[ -t 1 ]]` in a helper called that way is always false.
if [[ -t 1 ]]; then stdout_tty=1; else stdout_tty=0; fi

# Compact the visit log once it grows past this many lines.
PRUNE_THRESHOLD=5000
# Drop visits older than this during a prune.
PRUNE_MAX_AGE_DAYS=180

ensure_config() {
    mkdir -p "$config_dir"
    if [[ ! -f "$config" ]]; then
        cat > "$config" <<'EOF'
# lsrecent include-list: directories where plain `ls` (no arguments) shows the
# grouped-by-recency view. One absolute path per line; ~ is expanded.
# Managed by `lsrecent add|remove|edit` — manual edits are fine too.
EOF
    fi
}

resolve() {
    realpath -- "${1:-$PWD}" 2>/dev/null
}

# Fork-free clock. `date` costs ~7ms a call and this runs on every bare `ls`;
# bash's printf can do both without leaving the process.
now_epoch() {
    printf '%(%s)T' -1
}

# Epoch of today's local midnight, for calendar-day bucketing.
midnight_epoch() {
    local now h m s
    now=$(now_epoch)
    printf -v h '%(%H)T' -1
    printf -v m '%(%M)T' -1
    printf -v s '%(%S)T' -1
    printf '%s' "$(( now - (10#$h * 3600 + 10#$m * 60 + 10#$s) ))"
}

# Snap a timestamp to the nearest local midnight, using bash's own printf for the
# calendar arithmetic so that no `date` is forked.
#
# It iterates because one pass is not enough across a DST change: subtracting the
# wall-clock seconds since midnight assumes the offset has not moved in between, so
# on the day after a transition it lands an hour off — 23:00 the previous evening,
# or 01:00 the same morning. From there the residual points at the real midnight,
# and the second pass reaches it. Snapping to the *nearest* midnight rather than
# always downwards is what makes that converge instead of walking backwards a day
# at a time. Three passes is slack; every real zone settles in two.
#
# Verified exact on all 365 day boundaries of 2026 in Asia/Jerusalem, New_York,
# Sydney, Lord_Howe (30-minute DST), Chatham, Dublin, Kolkata and UTC. The one
# family it cannot be exact for is zones that transition *at* midnight, such as
# America/Santiago, where local midnight either does not exist or happens twice; it
# lands within the hour, which is well inside what recency bucketing cares about.
snap_midnight() {
    local t=$1 h m s secs i
    for i in 1 2 3; do
        printf -v h '%(%H)T' "$t"
        printf -v m '%(%M)T' "$t"
        printf -v s '%(%S)T' "$t"
        secs=$(( 10#$h * 3600 + 10#$m * 60 + 10#$s ))
        (( secs == 0 )) && break
        if (( secs > 43200 )); then t=$(( t + 86400 - secs )); else t=$(( t - secs )); fi
    done
    printf '%s' "$t"
}

# Epoch of yesterday's local midnight, given today's. Snapped from a moment in the
# middle of yesterday rather than reached by subtracting 86400, so a day that a DST
# change made 23 or 25 hours long still yields the right boundary.
yesterday_midnight_epoch() {
    snap_midnight "$(( $1 - 43200 ))"
}

# The recency window a listing is restricted to: "" (everything), today, or
# yesterday. Both named windows read the visit log only, and both bucket a repo by
# its *newest* visit — which is what makes them disjoint: something opened
# yesterday and again today is today's, and appears in no other list.
window=""
win_lo=0    # inclusive lower bound
win_hi=0    # exclusive upper bound; 0 = none

set_window() {
    window=$1
    local mid; mid=$(midnight_epoch)
    case "$window" in
        today)     win_lo=$mid; win_hi=0 ;;
        yesterday) win_hi=$mid; win_lo=$(yesterday_midnight_epoch "$mid") ;;
        *)         win_lo=0;    win_hi=0 ;;
    esac
}

in_window() {
    (( $1 >= win_lo )) || return 1
    (( win_hi == 0 || $1 < win_hi ))
}

die() {
    echo "lsrecent: $*" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Override management
# ---------------------------------------------------------------------------

cmd_add() {
    local d; d=$(resolve "$1") || die "no such directory: ${1:-$PWD}"
    [[ -d "$d" ]] || die "not a directory: $d"
    ensure_config
    if grep -qxF "$d" "$config"; then
        echo "lsrecent: already enabled for $d"
    else
        echo "$d" >> "$config"
        echo "lsrecent: enabled for $d"
    fi
}

cmd_remove() {
    local d; d=$(resolve "$1") || d="${1:-$PWD}"
    if [[ -f "$config" ]] && grep -qxF "$d" "$config"; then
        # grep -vxF, not sed: every sed address delimiter is a legal character in
        # a directory name, so a path containing the delimiter would either fail
        # to match or delete the wrong line. -F makes the whole path a literal.
        local tmp; tmp=$(mktemp "${config}.XXXXXX")
        grep -vxF "$d" "$config" > "$tmp" || true
        mv "$tmp" "$config"
        echo "lsrecent: disabled for $d"
    else
        echo "lsrecent: was not enabled for $d"
    fi
}

cmd_list() {
    [[ -f "$config" ]] || return 0
    local line
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        echo "${line/#\~/$HOME}"
    done < "$config"
}

cmd_check() {
    [[ -f "$config" ]] || exit 1

    # Try the unresolved path first. It matches in the overwhelming majority of
    # cases and costs no fork; realpath is only needed when the caller reached
    # the directory through a symlink.
    local raw="${1:-$PWD}" line
    local -a entries=()
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        line="${line/#\~/$HOME}"
        [[ "$raw" == "$line" ]] && exit 0
        entries+=("$line")
    done < "$config"

    (( ${#entries[@]} )) || exit 1
    local d; d=$(resolve "$raw") || exit 1
    [[ "$d" == "$raw" ]] && exit 1
    for line in "${entries[@]}"; do
        [[ "$d" == "$line" ]] && exit 0
    done
    exit 1
}

cmd_edit() {
    ensure_config
    "${EDITOR:-nano}" "$config"
}

# ---------------------------------------------------------------------------
# Visit log
#
# mtime answers "when did this change", not "when did I open it" — cd-ing into
# a repo touches nothing, and editing a nested file leaves the repo directory's
# own mtime alone. The visit log is the only honest source for "opened today",
# so it is recorded by the shell hook on every directory change.
# ---------------------------------------------------------------------------

cmd_visit() {
    local d; d=$(resolve "$1") || return 0
    [[ -e "$d/.git" ]] || return 0
    mkdir -p "$state_dir" 2>/dev/null || return 0
    printf '%s\t%s\n' "$(now_epoch)" "$d" >> "$visit_log" 2>/dev/null
    return 0
}

cmd_prune() {
    [[ -f "$visit_log" ]] || return 0
    local cutoff=$(( $(now_epoch) - PRUNE_MAX_AGE_DAYS * 86400 ))
    local tmp; tmp=$(mktemp "$state_dir/opened.XXXXXX") || return 0
    local -A keep=()
    local t p
    while IFS=$'\t' read -r t p; do
        [[ -n "$p" && "$t" =~ ^[0-9]+$ ]] || continue
        (( t < cutoff )) && continue
        [[ -d "$p" ]] || continue
        (( t > ${keep[$p]:-0} )) && keep[$p]=$t
    done < "$visit_log"
    for p in "${!keep[@]}"; do
        printf '%s\t%s\n' "${keep[$p]}" "$p"
    done | sort -n > "$tmp"
    mv -f "$tmp" "$visit_log"

    # Reply files from shells that died between the prompt and the cd. Harmless —
    # a PID is reused only after the file has been removed by the next listing in
    # that shell — but there is no reason to keep them.
    find "$state_dir" -maxdepth 1 -name 'cd.*' -mtime +1 -delete 2>/dev/null
    return 0
}

declare -A opened_ts=()

load_visits() {
    opened_ts=()
    [[ -f "$visit_log" ]] || return 0
    local lines
    lines=$(wc -l < "$visit_log" 2>/dev/null) || lines=0
    (( lines > PRUNE_THRESHOLD )) && cmd_prune
    local t p
    while IFS=$'\t' read -r t p; do
        [[ -n "$p" && "$t" =~ ^[0-9]+$ ]] || continue
        (( t > ${opened_ts[$p]:-0} )) && opened_ts[$p]=$t
    done < "$visit_log"
}

# ---------------------------------------------------------------------------
# Repository discovery
# ---------------------------------------------------------------------------

default_root() {
    local r
    for r in "${LSRECENT_REPO_ROOT:-}" "$HOME/repos/github" "$HOME/repos"; do
        [[ -n "$r" && -d "$r" ]] && { echo "$r"; return; }
    done
    echo "$PWD"
}

declare -A repo_ts=()

# Populates repo_ts[abs_path] = best-known "last touched" epoch, which is the
# newest of: the recorded visit, the repo directory's mtime, and .git's mtime
# (the last catches commits, checkouts and fetches that leave the worktree
# directory itself untouched).
collect_repos() {
    local root=$1
    local depth=${LSRECENT_REPO_DEPTH:-4}
    repo_ts=()

    # -mindepth 2 skips "$root/.git", so a root that is itself a repo is not
    # listed among the repos under it. It also keeps every emitted path strictly
    # below $root, which is what sorted_repos' prefix strip assumes.
    local ts path
    while IFS=$'\t' read -r ts path; do
        [[ -n "$path" ]] || continue
        ts=${ts%.*}
        (( ts > ${repo_ts[$path]:-0} )) && repo_ts[$path]=$ts
    done < <(find "$root" -mindepth 2 -maxdepth "$depth" -name .git -prune \
                  -printf '%T@\t%h\n' 2>/dev/null)

    (( ${#repo_ts[@]} )) || return 1

    local m p
    while IFS='|' read -r m p; do
        [[ -n "$p" ]] || continue
        (( m > ${repo_ts[$p]:-0} )) && repo_ts[$p]=$m
    done < <(stat -c '%Y|%n' -- "${!repo_ts[@]}" 2>/dev/null)

    for p in "${!opened_ts[@]}"; do
        [[ -v repo_ts[$p] ]] || continue
        (( opened_ts[$p] > repo_ts[$p] )) && repo_ts[$p]=${opened_ts[$p]}
    done

    # Explicit: without it the function returns the status of the arithmetic
    # above, so a visit that is merely not newer than the mtime reads as "no
    # repositories found" at every call site.
    return 0
}

# True if a git repo exists strictly below $1, without walking the whole tree —
# -quit stops at the first hit, which is the normal case.
has_nested_repo() {
    local hit
    hit=$(find "$1" -mindepth 2 -maxdepth "${LSRECENT_REPO_DEPTH:-4}" \
               -name .git -print -quit 2>/dev/null)
    [[ -n "$hit" ]]
}

# Emits "<epoch>\t<path relative to root>", newest first. With opened_only set,
# only repos with a recorded visit are emitted, timestamped by that visit —
# "when did I open this", with mtime ignored entirely. That is one timestamp per
# repo, the newest, which is what keeps the today and yesterday windows disjoint.
sorted_repos() {
    local root=$1 opened_only=${2:-0} p
    for p in "${!repo_ts[@]}"; do
        if (( opened_only )); then
            [[ -v opened_ts[$p] ]] || continue
            printf '%s\t%s\n' "${opened_ts[$p]}" "${p#"$root"/}"
        else
            printf '%s\t%s\n' "${repo_ts[$p]}" "${p#"$root"/}"
        fi
    done | sort -rn
}

# ---------------------------------------------------------------------------
# Presentation
# ---------------------------------------------------------------------------

term_cols() {
    echo "${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
}

print_header() {
    local color=$1 label=$2 cols=$3 fill
    local pad=$(( cols - ${#label} - 6 ))
    (( pad < 3 )) && pad=3
    printf -v fill '%*s' "$pad" ''
    printf '\e[1;%sm━━ %s ━%s\e[0m\n' "$color" "$label" "${fill// /━}"
}

# Numbering state. sel_n counts up across groups so a repo's number is unique in
# the whole listing, not just its bucket; sel_total is only needed to size the
# number column before the first group prints.
declare -a sel_paths=()
# The label as displayed ("topic/repo"), kept beside the path so the browser can
# re-render an entry that the first screenful never printed. Without it a search
# could find a hidden entry but have nothing to show for it but its full path.
declare -a sel_names=()
sel_n=0
sel_total=0
sel_shown=0

# How wide a group's columns must be and how many fit on a row. Split out of the
# printing so a group's row count is known *before* anything is emitted, which is
# what lets the row budget below decide where to stop.
pn_per=1
pn_numw=2
pn_namew=2
plan_columns() {
    local cols=$1; shift
    local e n max=0
    for e; do
        n=${e%%$'\t'*}
        (( ${#n} > max )) && max=${#n}
    done
    pn_numw=${#sel_total}
    (( pn_numw < 2 )) && pn_numw=2
    pn_namew=$(( max + 2 ))
    pn_per=$(( cols / (pn_numw + 2 + pn_namew) ))
    (( pn_per < 1 )) && pn_per=1
}

# Column-pack pre-ordered "display<TAB>abspath" entries, numbering as it goes.
# Call plan_columns for the same group first. `ls -C` cannot be reused at repo
# level: it re-sorts operands (or, with -U, only preserves order for names it can
# resolve from one directory), and repos live under many different parents.
# Filling row-major matters now that entries are numbered — column-major would
# print 1, 2, 3 down the page instead of across.
pack_numbered() {
    (( $# )) || return 0
    local e n path i=0
    for e; do
        n=${e%%$'\t'*}
        path=${e#*$'\t'}
        (( ++sel_n ))
        sel_paths[sel_n]=$path
        sel_names[sel_n]=$n
        printf '\e[90m%*d\e[0m \e[01;34m%-*s\e[0m' \
            "$pn_numw" "$sel_n" "$pn_namew" "$n"
        (( ++i % pn_per == 0 )) && printf '\n'
    done
    (( i % pn_per )) && printf '\n'
    return 0
}

# Number the entries that did not fit, without printing them. The listing is cut
# to one screenful but the ranking behind it is not, so a repo below the fold
# still gets a number and "23" resolves whether or not 23 was on screen. Without
# this the numbering stopped at the fold, which made every repo past the twentieth
# unreachable by the one mechanism the tool exists for. Only ever called after the
# last printed group — once anything is elided nothing later prints — so appending
# here cannot disturb the numbers already shown.
register_hidden() {
    local e
    for e; do
        (( ++sel_n ))
        sel_paths[sel_n]=${e#*$'\t'}
        sel_names[sel_n]=${e%%$'\t'*}
    done
    return 0
}

# Rows a listing may occupy. 0 means unlimited, which is also what a redirected
# stdout gets: a pipe should receive the whole listing, the same way `ls` drops
# its columns when it is not talking to a terminal.
row_budget() {
    local override=${LSRECENT_MAX_ROWS:-}
    if [[ -n "$override" ]]; then
        [[ "$override" =~ ^[0-9]+$ ]] || die "LSRECENT_MAX_ROWS must be a number: $override"
        echo "$override"
        return 0
    fi
    (( stdout_tty )) || { echo 0; return 0; }
    # LINES comes from shell-init. Falling back to `stty size` on /dev/tty rather
    # than `tput lines` for the same reason as above: tput sizes the terminal from
    # an ioctl on its own stdout, which here is a pipe, so it would answer with
    # terminfo's static default instead of the real height.
    local rows=${LINES:-}
    if [[ -z "$rows" ]]; then
        rows=$( { stty size < /dev/tty; } 2>/dev/null )
        rows=${rows%% *}
    fi
    [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
    # Spend at most the visible screen, leaving the prompt and the "N more"
    # footer somewhere to land.
    echo $(( rows > 6 ? rows - 3 : 3 ))
}

# Persist the numbering so the shell's number-functions can resolve it after the
# listing process has exited. Written once per listing, replacing the last one.
write_sel_map() {
    (( ${#sel_paths[@]} )) || return 0
    mkdir -p "$state_dir" 2>/dev/null || return 0
    local tmp i
    tmp=$(mktemp "$state_dir/last-list.XXXXXX") || return 0
    for i in "${!sel_paths[@]}"; do
        printf '%s\t%s\n' "$i" "${sel_paths[$i]}"
    done > "$tmp"
    mv -f "$tmp" "$sel_map" 2>/dev/null
    return 0
}

# Said instead of prompting when the listing cannot be answered. A missing prompt
# is the one failure this tool can have that looks like no failure at all — the
# numbers print, nothing asks for one, and nothing on screen explains why — and
# its usual cause is a shell still running functions it eval'd before the binary
# was upgraded underneath it, sometimes days before. Hence the version handshake:
# shell-init exports the version that defined the functions, and a shell that
# exported nothing predates the handshake, so is stale by definition.
stale_integration_notice() {
    local loaded=${LSRECENT_SHELL:-} why
    [[ "$loaded" != "$VERSION" ]] || return 0
    if [[ -n "$loaded" ]]; then
        why="shell has $loaded, binary is $VERSION"
    else
        why="not loaded in this shell"
    fi
    printf '\e[90m→ cd-by-number needs the shell integration reloaded (%s) — `source ~/.bashrc`, or open a new terminal\e[0m\n' \
        "$why"
}

# Ask which entry to cd into, straight after printing the listing. Interactive is
# the default because a numbered listing is a question, and the numbers are only
# useful while they are still on the screen above the cursor.
#
# The prompt talks to /dev/tty, not stdin/stdout: stdin may be anything, and
# stdout is the listing itself (possibly a pipe). The answer leaves by a third
# channel again — the file named in $LSRECENT_CD_FILE — because a process cannot
# cd its parent shell; the shell function that set the variable does that. With
# the variable unset there is nobody to act on a choice, so the notice above
# stands in for the prompt rather than a question nothing could honour: that
# covers both a stale shell and `lsrecent repos` run straight from argv, where
# typing a number would not work either.
prompt_jump() {
    local dest=${LSRECENT_CD_FILE:-}
    (( stdout_tty )) || return 0
    [[ "${LSRECENT_PROMPT:-1}" != 0 ]] || return 0
    (( ${#sel_paths[@]} )) || return 0
    [[ -n "$dest" ]] || { stale_integration_notice; return 0; }
    [[ -r /dev/tty && -w /dev/tty ]] || return 0

    browse "$dest"
}

# --- the browser -------------------------------------------------------------
#
# What turns the listing from a screenful into something you cannot fail to get an
# answer out of. The first screenful is the twenty most recent repositories; the
# ranking behind it is often hundreds long, and before this the only ways to reach
# #237 were to abandon the listing for `lsrepos --all` or for fzf. Now the same
# prompt that takes a number also takes a search, and pages.
#
# It stays line-oriented on purpose. A full-screen alternate-screen TUI would be
# the conventional answer, but this tool's whole premise is that the listing lands
# in your scrollback and stays there — the numbers are useful precisely because
# they are still above the cursor after you have moved on. An app that clears the
# screen on exit throws that away, so each page is printed and scrolls like any
# other command output.
#
# `view` holds ranking positions, never entries. Filtering and paging therefore
# cannot renumber anything: 237 is the 237th most recently touched repository on
# the first screen, inside a search, and after `lsrecent path 237` tomorrow.
declare -a view=()
view_from=0
view_filter=''

build_view() {
    view=()
    local i hay needle=${view_filter,,}
    for (( i = 1; i <= sel_n; i++ )); do
        [[ -n "${sel_names[i]:-}" ]] || continue
        if [[ -n "$needle" ]]; then
            # Label and path both, lowercased: "noisy" should find the repo, and
            # "smart-home" should find everything filed under that topic even
            # though the topic is only part of some labels.
            hay=${sel_names[i],,}$'\n'${sel_paths[i],,}
            [[ "$hay" == *"$needle"* ]] || continue
        fi
        view+=( "$i" )
    done
    view_from=0
}

# Print one page of `view` starting at view_from, and advance it. With $1 set,
# print the lot regardless of the row budget.
render_page() {
    local unlimited=${1:-}
    local total=${#view[@]}
    if (( total == 0 )); then
        printf '\e[90mnothing matches "%s" — / on its own clears the search\e[0m\n' \
            "$view_filter" > /dev/tty
        return 0
    fi

    local i n label max=0 cols numw namew per
    for (( i = view_from; i < total; i++ )); do
        label=${sel_names[${view[i]}]}
        (( ${#label} > max )) && max=${#label}
    done
    cols=$(term_cols)
    numw=${#sel_n}
    (( numw < 2 )) && numw=2
    namew=$(( max + 2 ))
    per=$(( cols / (numw + 2 + namew) ))
    (( per < 1 )) && per=1

    local cap=$(( total - view_from ))
    if [[ -z "$unlimited" ]]; then
        local budget; budget=$(row_budget)
        (( budget > 0 )) && (( budget * per < cap )) && cap=$(( budget * per ))
    fi

    local printed=0
    for (( i = view_from; i < view_from + cap; i++ )); do
        n=${view[i]}
        printf '\e[90m%*d\e[0m \e[01;34m%-*s\e[0m' \
            "$numw" "$n" "$namew" "${sel_names[n]}" > /dev/tty
        (( ++printed % per == 0 )) && printf '\n' > /dev/tty
    done
    (( printed % per )) && printf '\n' > /dev/tty

    local first=$(( view_from + 1 )) last=$(( view_from + printed ))
    view_from=$last
    local scope=''
    [[ -n "$view_filter" ]] && scope=" matching \"$view_filter\""
    if (( view_from < total )); then
        printf '\e[90m… %d-%d of %d%s · + for the next %d\e[0m\n' \
            "$first" "$last" "$total" "$scope" \
            "$(( total - view_from < printed ? total - view_from : printed ))" > /dev/tty
    else
        printf '\e[90m… %d-%d of %d%s · end\e[0m\n' \
            "$first" "$last" "$total" "$scope" > /dev/tty
    fi
}

browse_help() {
    cat > /dev/tty <<EOF
$(printf '\e[90m')  23        cd into entry 23 — numbers are the ranking, not the page
  text      search labels and paths for "text" (case-insensitive)
  /         clear the search and go back to the full ranking
  +         next page          -    back to the top of this view
  a         everything in this view, unpaged
  ?         this          enter, q or ctrl-d    stay put$(printf '\e[0m')
EOF
}

browse() {
    local dest=$1 reply d
    build_view
    # The first screenful is already above the prompt — cmd_repos printed it — so
    # `+` continues the ranking rather than repeating its opening. Only the
    # unfiltered view inherits this; a search starts from its own first result.
    view_from=$sel_shown

    while :; do
        printf '\e[90m→ number, text to search, + more, ? help, enter stays: \e[0m' \
            > /dev/tty
        # A bare `read` with no reply (EOF from ctrl-d) leaves the cursor mid-line.
        IFS= read -r reply < /dev/tty || { printf '\n' > /dev/tty; return 0; }

        case "$reply" in
            ''|q|Q)
                return 0 ;;
            '?')
                browse_help; continue ;;
            '+'|n|N|more)
                if (( view_from >= ${#view[@]} )); then
                    printf '\e[90mthat is the end of the list\e[0m\n' > /dev/tty
                else
                    render_page
                fi
                continue ;;
            '-'|p|P)
                # Back to the top rather than a true previous page: the pages are
                # already in the scrollback above, so scrolling up is the honest
                # way to see them again, and re-printing them would only make the
                # same rows appear twice with the same numbers.
                view_from=0; render_page; continue ;;
            a|A|all)
                view_from=0; render_page unlimited; continue ;;
            /)
                view_filter=''; build_view; render_page; continue ;;
        esac

        # A leading slash is accepted but not required. Bare text is the more
        # forgiving default: anyone who types a repository name at a prompt that
        # invites one means to search for it, and no valid selection is anything
        # other than digits.
        if [[ "$reply" == /* ]]; then
            view_filter=${reply#/}
            build_view
            render_page
            continue
        fi

        if [[ ! "$reply" =~ ^[0-9]+$ ]]; then
            view_filter=$reply
            build_view
            render_page
            continue
        fi

        if [[ -z ${sel_paths[10#$reply]:-} ]]; then
            printf '\e[90mno entry %s — 1-%d, or text to search\e[0m\n' \
                "$reply" "$sel_n" > /dev/tty
            continue
        fi
        d=${sel_paths[10#$reply]}
        if [[ ! -d "$d" ]]; then
            printf '\e[90mgone since the listing: %s\e[0m\n' "$d" > /dev/tty
            continue
        fi
        # Echoed so the destination survives in the scrollback: the prompt line
        # that follows shows the new directory, but this says which number it was.
        printf '\e[90m%s\e[0m\n' "$d" > /dev/tty
        printf '%s\n' "$d" > "$dest" 2>/dev/null
        return 0
    done
}

# Resolve a number from the last listing to its path.
cmd_path() {
    local want=$1
    [[ "$want" =~ ^[0-9]+$ ]] || die "not a number: $want"
    [[ -f "$sel_map" ]] || die "no listing recorded yet — run ls, lsrepos or lstoday first"
    local n p
    while IFS=$'\t' read -r n p; do
        [[ "$n" == "$want" ]] || continue
        [[ -d "$p" ]] || die "gone since the listing: $p"
        printf '%s\n' "$p"
        return 0
    done < "$sel_map"
    die "no entry $want in the last listing"
}

# ---------------------------------------------------------------------------
# Grouped listing — directory level (original behaviour)
# ---------------------------------------------------------------------------

cmd_show() {
    local target="" passthru=()
    while (( $# )); do
        case "$1" in
            --all|-a) passthru+=("$1") ;;
            -*)       die "unknown option: $1" ;;
            *)        target=$1 ;;
        esac
        shift
    done
    [[ -n "$target" ]] || target="."
    [[ -d "$target" ]] || die "not a directory: $target"

    # A directory that only groups repositories is more useful listed as
    # repositories than as children: its subfolders are organisational (a topic
    # is never the thing being opened) and any loose notes beside them are noise.
    # A directory that is itself a repo keeps the child listing — there the files
    # and folders *are* the content.
    if [[ ! -e "$target/.git" ]] && has_nested_repo "$target"; then
        local abs; abs=$(resolve "$target") || die "no such directory: $target"
        cmd_repos "${passthru[@]}" "$abs"
        return
    fi

    local cols; cols=$(term_cols)
    local now midnight
    now=$(now_epoch)
    midnight=$(midnight_epoch)

    local g_today=() g_week=() g_month=() g_quarter=() g_older=()
    local name mtime age_days

    # One `find` for the whole directory rather than a `stat` per entry: at 30
    # entries that is 194ms against 8ms, and unlike a batched `stat "$dir"/*`
    # it has no argument-list ceiling. NUL-delimited so newlines in names are
    # safe; `! -name '.*'` preserves the glob's behaviour of skipping dotfiles.
    while IFS='|' read -r -d '' mtime name; do
        [[ -n "$name" ]] || continue
        mtime=${mtime%.*}
        if (( mtime >= midnight )); then
            g_today+=("$name")
            continue
        fi
        age_days=$(( (now - mtime) / 86400 ))
        if   (( age_days <= 7 ));  then g_week+=("$name")
        elif (( age_days <= 30 )); then g_month+=("$name")
        elif (( age_days <= 90 )); then g_quarter+=("$name")
        else                            g_older+=("$name")
        fi
    done < <(find "$target" -mindepth 1 -maxdepth 1 ! -name '.*' \
                  -printf '%T@|%f\0' 2>/dev/null)

    # Bucket contents are ordered by `ls -t` at print time, so the order find
    # happened to yield does not matter here.

    local shown=0

    show_group() {
        local color=$1 label=$2
        shift 2
        (( $# == 0 )) && return
        (( shown )) && echo
        shown=1
        print_header "$color" "$label" "$cols"
        ( cd "$target" && command ls -dtC -w "$cols" --color=always -- "$@" )
    }

    show_group 92 "TODAY"          "${g_today[@]}"
    show_group 96 "PAST WEEK"      "${g_week[@]}"
    show_group 93 "PAST MONTH"     "${g_month[@]}"
    show_group 95 "PAST 3 MONTHS"  "${g_quarter[@]}"
    show_group 90 "OLDER"          "${g_older[@]}"

    (( shown )) || echo "(empty)"
}

# ---------------------------------------------------------------------------
# Grouped listing — repository level
# ---------------------------------------------------------------------------

cmd_repos() {
    local want_window="" full=0 no_limit=0 root=""
    while (( $# )); do
        case "$1" in
            --today)     want_window=today ;;
            --yesterday) want_window=yesterday ;;
            --full)      full=1 ;;
            --all|-a)    no_limit=1 ;;
            -*)          die "unknown option: $1" ;;
            *)           root=$1 ;;
        esac
        shift
    done
    set_window "$want_window"
    [[ -n "$root" ]] || root=$(default_root)
    root=$(resolve "$root") || die "no such directory: $root"
    [[ -d "$root" ]] || die "not a directory: $root"

    load_visits
    collect_repos "$root" || die "no git repositories under $root"

    local cols; cols=$(term_cols)
    local now midnight y_midnight
    now=$(now_epoch)
    midnight=$(midnight_epoch)
    y_midnight=$(yesterday_midnight_epoch "$midnight")

    # Entries are "display<TAB>abspath": the display name drops the topic folder
    # unless --full, but the number has to resolve to a real path, and sorted_repos
    # yields paths relative to root.
    local g_today=() g_yest=() g_week=() g_month=() g_quarter=() g_older=()
    local ts rel name entry age_days
    local opened_only=0; [[ -n "$window" ]] && opened_only=1
    while IFS=$'\t' read -r ts rel; do
        [[ -n "$rel" ]] || continue
        in_window "$ts" || continue
        if (( full )); then name=$rel; else name=${rel##*/}; fi
        entry="$name"$'\t'"$root/$rel"
        # YESTERDAY is its own bucket in the unrestricted listing too, not folded
        # into PAST WEEK: "was that today or yesterday?" is the question actually
        # being asked, and a repo has one newest timestamp, so it lands in exactly
        # one of them. With a window set every entry falls in a single bucket
        # anyway, and the group loop below prints just that one.
        if   (( ts >= midnight ));   then g_today+=("$entry")
        elif (( ts >= y_midnight )); then g_yest+=("$entry")
        else
            age_days=$(( (now - ts) / 86400 ))
            if   (( age_days <= 7 ));  then g_week+=("$entry")
            elif (( age_days <= 30 )); then g_month+=("$entry")
            elif (( age_days <= 90 )); then g_quarter+=("$entry")
            else                            g_older+=("$entry")
            fi
        fi
    done < <(sorted_repos "$root" "$opened_only")

    sel_total=$(( ${#g_today[@]} + ${#g_yest[@]} + ${#g_week[@]} + ${#g_month[@]} \
                  + ${#g_quarter[@]} + ${#g_older[@]} ))

    # Print oldest-group-last, stopping when the screen is full. Because both the
    # groups and their contents run newest-first, cutting from the end drops
    # exactly the least interesting repos — so a truncated listing is still the
    # right answer to "what was I working on recently?", and the numbering only
    # ever covers what is actually on screen.
    local -a group_labels=("TODAY" "YESTERDAY" "PAST WEEK" "PAST MONTH" "PAST 3 MONTHS" "OLDER")
    local -a group_colors=(92 32 96 93 95 90)
    local -a group_vars=(g_today g_yest g_week g_month g_quarter g_older)

    local budget=0
    (( no_limit )) || budget=$(row_budget)

    local shown=0 used=0 hidden=0 i count overhead rows_needed avail take ref
    for i in "${!group_vars[@]}"; do
        # Copied out by indirect expansion rather than a nameref: a `local -n`
        # cannot be re-pointed on the next iteration without unsetting it first,
        # and the `continue`s below would skip that unset.
        ref="${group_vars[$i]}[@]"
        local -a grp=("${!ref}")
        count=${#grp[@]}
        (( count )) || continue

        # Once anything has been cut, the rest is only counted for the footer:
        # showing a later group after eliding an earlier one would misrepresent
        # the recency order the whole listing is built on.
        if (( hidden )); then
            hidden=$(( hidden + count ))
            register_hidden "${grp[@]}"
            continue
        fi

        plan_columns "$cols" "${grp[@]}"
        rows_needed=$(( (count + pn_per - 1) / pn_per ))
        overhead=1
        (( shown )) && overhead=2   # blank separator line, then the header

        take=$count
        if (( budget > 0 )); then
            avail=$(( budget - used - overhead ))
            # The newest group always gets its header and at least one row: a
            # budget too small to fit anything must not make a non-empty listing
            # fall through to the "nothing here" message.
            (( shown == 0 && avail < 1 )) && avail=1
            if (( avail < 1 )); then
                hidden=$(( hidden + count ))
                register_hidden "${grp[@]}"
                continue
            fi
            if (( rows_needed > avail )); then
                rows_needed=$avail
                take=$(( avail * pn_per ))
                (( take > count )) && take=$count
            fi
        fi

        (( shown )) && echo
        shown=1
        print_header "${group_colors[$i]}" "${group_labels[$i]}" "$cols"
        pack_numbered "${grp[@]:0:take}"
        sel_shown=$sel_n
        (( take < count )) && register_hidden "${grp[@]:take}"
        used=$(( used + overhead + rows_needed ))
        hidden=$(( hidden + count - take ))
    done

    if (( shown )); then
        if (( hidden )); then
            local hint="lsrepos"
            case "$window" in
                today)     hint="lstoday" ;;
                yesterday) hint="lsyesterday" ;;
            esac
            # The elided repos are still numbered, so the footer names the range
            # rather than only offering --all: typing 23 works from here.
            printf '\e[90m… %d more, numbered %d-%d · %s --all to see them\e[0m\n' \
                "$hidden" "$(( sel_shown + 1 ))" "$sel_n" "$hint"
        fi
        write_sel_map
        prompt_jump
        return 0
    fi

    if [[ -n "$window" ]]; then
        printf '\e[90mNo repos opened %s under %s\e[0m\n' "$window" "$root"
        [[ -s "$visit_log" ]] || printf '\e[90mThe visit log is empty — it starts filling once the shell hook is loaded (open a new shell).\e[0m\n'
    else
        echo "(no repositories found under $root)"
    fi
}

# ---------------------------------------------------------------------------
# Picker
# ---------------------------------------------------------------------------

cmd_pick() {
    local want_window="" root=""
    while (( $# )); do
        case "$1" in
            --today)     want_window=today ;;
            --yesterday) want_window=yesterday ;;
            -*)          die "unknown option: $1" ;;
            *)           root=$1 ;;
        esac
        shift
    done
    set_window "$want_window"
    command -v fzf >/dev/null || die "pick requires fzf"
    [[ -n "$root" ]] || root=$(default_root)
    root=$(resolve "$root") || die "no such directory: $root"

    load_visits
    collect_repos "$root" || die "no git repositories under $root"

    local opened_only=0; [[ -n "$window" ]] && opened_only=1
    local names=() ts name
    while IFS=$'\t' read -r ts name; do
        in_window "$ts" || continue
        names+=("$name")
    done < <(sorted_repos "$root" "$opened_only")

    (( ${#names[@]} )) || die "nothing to pick"

    local prompt="repo> "
    [[ -n "$window" ]] && prompt="$window> "

    local preview='p='"$(printf '%q' "$root")"'/{}
        git -C "$p" -c color.ui=always log --oneline -8 2>/dev/null
        echo
        git -C "$p" -c color.ui=always status -sb 2>/dev/null | head -15'

    local sel
    sel=$(printf '%s\n' "${names[@]}" | fzf \
            --ansi --no-sort --height=60% --reverse \
            --prompt="$prompt" \
            --preview="$preview" \
            --preview-window=right,55%,border-left) || return 1

    [[ -n "$sel" ]] && printf '%s\n' "$root/$sel"
}

# ---------------------------------------------------------------------------
# Shell integration
# ---------------------------------------------------------------------------

# Put the eval into ~/.bashrc, idempotently. Lives here rather than in install.sh
# because the .deb has no install.sh to call: the package cannot do this itself
# (a root postinst has no business editing user dotfiles, and does not know which
# users want it), so the user runs this once per account.
#
# The search looks for the eval line itself in every file bash might source it
# from, not for our own marker comment — someone who added the line by hand has
# the integration installed, and a second eval is redundant clutter that has to
# be found and removed by hand later.
cmd_shell_install() {
    local f
    for f in ~/.bashrc ~/.bash_aliases ~/.bash_profile ~/.profile; do
        [[ -f "$f" ]] || continue
        if grep -q 'lsrecent shell-init' "$f" 2>/dev/null; then
            echo "lsrecent: shell integration already present in $f"
            return 0
        fi
    done
    {
        echo ""
        echo "# lsrecent shell integration"
        echo 'eval "$(lsrecent shell-init)"'
    } >> ~/.bashrc
    echo "lsrecent: added shell integration to ~/.bashrc"
    echo "lsrecent: run \`source ~/.bashrc\` or open a new terminal"
}

cmd_shell_init() {
    # Exported, not just set: the binary is a child process, and this is how it
    # knows which vintage of the functions below is calling it. See
    # stale_integration_notice.
    printf 'export LSRECENT_SHELL=%s\n' "$VERSION"
    cat <<'EOF'
alias lsr='lsrecent'
alias lsr-add='lsrecent add'
alias lsr-remove='lsrecent remove'
alias lsr-edit='lsrecent edit'

# Escape hatch: plain `ls`, even in a directory where the grouped view is the
# default. Takes the same arguments and colours as the real thing.
lsreg() {
    command ls --color=auto "$@"
}

# Typing a number at the *later* prompt — after the listing's own prompt has been
# answered or dismissed — cds into that entry too. The numbers have to be real
# shell functions defined in *this* shell: `command_not_found_handle` is run in a
# forked subshell, so a cd from there is lost when it exits. That in turn is why
# the grouped views are functions rather than aliases — they rebind after printing,
# so the numbers on screen are always the current ones.
__lsrecent_bound=()
__lsrecent_bind_numbers() {
    (( ${#__lsrecent_bound[@]} )) && unset -f "${__lsrecent_bound[@]}" 2>/dev/null
    __lsrecent_bound=()
    local map="${XDG_DATA_HOME:-$HOME/.local/share}/lsrecent/last-list"
    [[ -f $map ]] || return 0
    # One eval for the whole map, not one per number: the map covers every repo in
    # the ranking, not just the screenful that was printed, so this is a couple of
    # hundred definitions on a listing rather than twenty.
    local n defs=""
    while IFS=$'\t' read -r n _; do
        [[ $n =~ ^[0-9]+$ ]] || continue
        defs+="$n() { __lsrecent_jump $n; }
"
        __lsrecent_bound+=("$n")
    done < "$map"
    [[ -n $defs ]] && eval "$defs"
    return 0
}

__lsrecent_jump() {
    local d
    d=$(lsrecent path "$1") || return 1
    [[ -n $d ]] && cd "$d"
}

# Every listing goes through here, so every listing is interactive: the binary
# prints, prompts, and writes the chosen path to $LSRECENT_CD_FILE, and this
# function — running in your shell, unlike the binary — does the cd.
#
# COLUMNS and LINES are set by interactive bash but not exported, so they are
# passed through explicitly; otherwise the binary has to fork `tput` to size the
# listing and its row budget. The reply file is named after this shell's PID, so
# two terminals listing at the same time cannot read each other's answer, and it
# is a fixed name rather than `mktemp` so the hot path stays fork-free.
__lsrecent_list() {
    local f="$__lsrecent_state/cd.$$" rc d
    rm -f "$f" 2>/dev/null
    COLUMNS="${COLUMNS:-}" LINES="${LINES:-}" LSRECENT_CD_FILE="$f" lsrecent "$@"
    rc=$?
    (( rc == 0 )) && __lsrecent_bind_numbers
    if [[ -s $f ]]; then
        d=$(<"$f")
        rm -f "$f" 2>/dev/null
        [[ -d $d ]] && cd "$d"
    fi
    return $rc
}

lsrepos()     { __lsrecent_list repos "$@"; }
lstoday()     { __lsrecent_list today "$@"; }
lsyesterday() { __lsrecent_list yesterday "$@"; }

ls() {
    if (( $# == 0 )) && [[ -t 1 ]] && lsrecent check 2>/dev/null; then
        __lsrecent_list
    else
        command ls --color=auto "$@"
    fi
}

# Pick a repo and cd into it. `lsrp` = all repos, `lsrt` = today's, `lsry` =
# yesterday's.
lsrp() {
    local d
    d=$(lsrecent pick "$@") && [[ -n "$d" ]] && cd "$d"
}
lsrt() {
    lsrp --today "$@"
}
lsry() {
    lsrp --yesterday "$@"
}

# Visit logging. Deliberately inline rather than a call into the binary: this
# runs on every prompt, so it must not fork. The binary's `lsrecent visit` is
# the equivalent for non-bash shells.
__lsrecent_state="${XDG_DATA_HOME:-$HOME/.local/share}/lsrecent"
[[ -d $__lsrecent_state ]] || mkdir -p "$__lsrecent_state" 2>/dev/null
__lsrecent_last=""
__lsrecent_visit() {
    [[ $PWD == "$__lsrecent_last" ]] && return
    __lsrecent_last=$PWD
    [[ -e $PWD/.git ]] || return
    printf '%s\t%s\n' "${EPOCHSECONDS:-$(date +%s)}" "$PWD" \
        >> "$__lsrecent_state/opened.log" 2>/dev/null
}
if [[ ${PROMPT_COMMAND@a} == *a* ]]; then
    __lsrecent_found=0
    for __lsrecent_pc in "${PROMPT_COMMAND[@]}"; do
        [[ $__lsrecent_pc == *__lsrecent_visit* ]] && __lsrecent_found=1
    done
    (( __lsrecent_found )) || PROMPT_COMMAND=(__lsrecent_visit "${PROMPT_COMMAND[@]}")
    unset __lsrecent_found __lsrecent_pc
else
    case "$PROMPT_COMMAND" in
        *__lsrecent_visit*) ;;
        *) PROMPT_COMMAND="__lsrecent_visit${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
    esac
fi
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
    add)         cmd_add "${2:-}" ;;
    remove|rm)   cmd_remove "${2:-}" ;;
    list)        cmd_list ;;
    check)       cmd_check "${2:-}" ;;
    edit)        cmd_edit ;;
    visit)       cmd_visit "${2:-}" ;;
    prune)       load_visits; cmd_prune ;;
    repos)       shift; cmd_repos "$@" ;;
    today)       shift; cmd_repos --today "$@" ;;
    yesterday|yest) shift; cmd_repos --yesterday "$@" ;;
    pick)        shift; cmd_pick "$@" ;;
    path)        cmd_path "${2:-}" ;;
    shell-init)  cmd_shell_init ;;
    shell-install) cmd_shell_install ;;
    # exec, not a background launch: run from a terminal this is a foreground app
    # like any other, and the desktop entry calls lsrecent-gui directly anyway.
    gui)         command -v lsrecent-gui >/dev/null 2>&1 \
                     || die "lsrecent-gui is not installed (needs python3-pyqt6)"
                 shift; exec lsrecent-gui "$@" ;;
    # Reports the shell half as well as the binary, because "the numbers don't do
    # anything" is answered by comparing the two and nothing else can show them.
    -v|--version|version)
        case "${LSRECENT_SHELL:-}" in
            "$VERSION") echo "lsrecent $VERSION (shell integration: loaded)" ;;
            '')         echo "lsrecent $VERSION (shell integration: not loaded in this shell)" ;;
            *)          echo "lsrecent $VERSION (shell integration: $LSRECENT_SHELL — stale, run \`source ~/.bashrc\`)" ;;
        esac
        ;;
    -h|--help|help)
        # The header comment block, minus the shebang, is the help text. Bounded by
        # the first line that is not a comment rather than a fixed line range, so
        # editing the header cannot silently truncate --help.
        awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
        ;;
    *)           cmd_show "${1:-}" ;;
esac
