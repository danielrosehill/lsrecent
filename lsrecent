#!/usr/bin/env bash
# lsrecent — recency-grouped listing, at directory or repository level, with a
# per-directory ls override and an fzf picker.
#
# Listing:
#   lsrecent [dir]           Grouped listing of dir (default: .). A directory
#                            that merely groups repositories is listed as
#                            repositories; a repo is listed by its children.
#   lsrecent repos [root]    Grouped listing of every git repo under root,
#                            shown at repo level (topic/repo), newest first
#   lsrecent today [root]    Only the repos opened today
#   lsrecent yesterday [root]
#                            Only the repos whose last visit was yesterday. One
#                            opened today as well belongs to today, not here.
#   lsrecent pick [root]     fzf picker over repos; prints the chosen path
#                            (use the `lsrp` / `lsrt` / `lsry` functions to cd)
#
# Searching from the command line. A positional argument written like a path — it
# has a slash in it, or it is `.` or `..` — is the root. Anything else is a search
# over repository names and paths, and the listing is reduced to what matches
# before it is bucketed, so it prints as an ordinary grouped listing numbered from
# 1:
#   lsrepos wms              every repo matching "wms", grouped by recency
#   lstoday claude           today's, narrowed
#   lsr wms                  the same, by the shortest route
# A search matching exactly one repository does not bother asking: it prints the
# match and cds there. `lsr ./wms` still means the directory. Hyphens, underscores
# and spaces match each other, so "wheres my" finds Wheres-My-Stuff.
#
# Timeframes. --since SPEC (or --within) keeps only repos touched in the last
# stretch of calendar days, today included, and combines with a search:
#   lsrepos --since today claude    today's repos matching "claude"
#   SPEC: today, yesterday, week, month, N or Nd (days), Nw, Nm
# Unlike --today, which reads the visit log alone, this cuts over the listing's
# own dates, so --since today is exactly what sits under TODAY.
#
# Busy days. When TODAY holds at least focus_today repos (default 10), the plain
# listing shows only today, and enter at the prompt prints more of today instead
# of staying put (q stays). Older repos are still numbered after today's, and n
# pages on to them. A search, a timeframe, --today or --all turns it off for that
# listing; focus_today = 0 turns it off for good.
#
# Names. Repo names print with hyphens and underscores as spaces — Wheres My Stuff
# for Wheres-My-Stuff — unless pretty_names = 0. Display only.
#
# Buckets. The last week is one bucket per calendar day — TODAY, YESTERDAY, then
# 2 DAYS AGO through 7 DAYS AGO — and then PAST MONTH, PAST 3 MONTHS and OLDER. A
# repo has one timestamp, so it appears under exactly one of them.
#
# Ordering. Groups run newest-first. Within a group the order is one of four;
# `s` at the prompt cycles them and `sr`/`sf`/`sv`/`sn` jump straight to one,
# without leaving the listing:
#   --recency  (-t)  most recently opened first — the default, and what TODAY is
#                    usually being read for: the last thing you were in is the
#                    first line on the screen. (--time is the old spelling.)
#   --visits   (-A)  busiest first — how many times the visit log recorded you
#                    opening it inside that bucket's own day. The day you touched
#                    forty repos becomes the four you actually worked in.
#                    (--activity is the old spelling.)
#   --frecency (-f)  visits first, most recent breaking the ties. Neither signal
#                    alone is the question: the repo you opened nine times today
#                    beats the one you opened once at lunch, and among equals the
#                    newest wins. A bucket nobody visited is all zeroes, so it
#                    stays in recency order rather than collapsing to the alphabet.
#   --name     (-n)  alphabetical — a bucket you scan for a name you already have
#                    in mind
# The default is whichever `sort` the settings file names, or recency. `ss` at the
# prompt writes the order you are looking at there, so the order is chosen by
# pressing `s` until the screen is right and then keeping it; `lsrecent config set
# sort visits` is the same thing said outright. LSRECENT_SORT still overrides both
# for one shell.
#
# Bulk touches. A repo's date is inferred from the filesystem when the visit log
# has nothing newer, and one command run across every repo — a mass fetch, a
# permissions sweep, a backup — dates them all to that moment and empties the
# listing of meaning. So a calendar day whose *inferred* dates cover more than
# LSRECENT_NOISE_PCT (default 50) of all repos is treated as a bulk touch: those
# dates are discarded, the repos land in UNDATED rather than TODAY, and a footer
# says so. Visit-log dates are never discarded — a bulk command opens nothing.
#   lsrecent noise           What is being suppressed, and why
#   lsrecent noise add [day] Suppress a day by hand (default: today)
#   lsrecent noise remove <day>
#                            Trust it again, auto-detected or not
# LSRECENT_NOISE_PCT=0 turns the automatic half off and leaves only the list.
#
# Choosing an entry. Repo listings are numbered straight down the listing — 1 is
# the first repo of the newest group — and end with a prompt: type a number,
# press enter, and you are in that repo.
# Enter on its own (or q, or ctrl-d) stays put. Because a
# process cannot cd its parent shell, the chosen path is written to
# $LSRECENT_CD_FILE and the shell function that set it does the cd; the numbers
# are also bound as shell functions, so they keep working after the prompt is
# gone. LSRECENT_PROMPT=0 suppresses the prompt (listing only, as before), and
# `lsrecent path N` resolves a number to its path.
#
# The prompt is also a browser, so the screenful is never the limit of what you
# can reach from it:
#   23        cd into entry 23 — numbers are the ranking, not the page
#   text      search labels and paths, case-insensitive; a bare word is a search.
#             Results come one per row, newest first, each with when it was last
#             touched; today's sit under a TODAY bar and their time is lit up. A
#             cursor (▶) starts on the first result: enter goes there, up/down
#             (or ctrl-p/ctrl-n) move it, typing anything else starts a new line
#             at the prompt. search_order = match ranks whole name, then
#             starts-with, then contains, then path-only instead. The matched
#             characters are highlighted inside the name. `lsrepos laptop` on a
#             terminal opens straight into the same list.
#   /         clear the search and any timeframe, back to the full ranking
#   @3d text  search only what was touched in a timeframe (@today, @yesterday,
#             @week, @month, @3d, @2w); @ alone drops the timeframe
#   n  or +   next page                 p  or -   previous page
#   t         back to the top of this view
#   a         everything in this view, unpaged
#   s         cycle the order inside each group: recency → frecency → visits → name
#   sr  recency    sf  frecency    sv  visits    sn  name
#   ss        keep that order — every listing starts in it from now on
#   c         the settings menu (also /config); the listing redraws after it
#   ?         the same summary          enter, q, ctrl-d   stay put
#             (on a busy day, enter shows more of today until today runs out)
#
# Every one of those keys prints in its own colour, distinct from the prose
# describing it, wherever the tool offers it — the prompt line, the help, the
# paging footer. A hint line is part key and part explanation, and the key is the
# only part you are meant to type.
#
# The prompt needs the shell half of the pair to be current: shell-init exports
# LSRECENT_SHELL with its version, and a listing that finds it missing or older
# than this binary says so instead of prompting. A shell that was open across an
# upgrade is still running the functions it eval'd at startup — `source ~/.bashrc`
# replaces them. `lsrecent --version` reports both halves.
#
# Repo listings stop at one screenful, oldest group cut first, and say how many they
# elided — but the elided repos are numbered too, the footer gives their range,
# and the prompt can page or search into them, so a number past the fold still cds. `--all` (`-a`) prints everything;
# $LSRECENT_MAX_ROWS overrides the row budget (0 = unlimited). A redirected or
# piped listing is never truncated.
#
# Override management (the "micro-backend"):
#   lsrecent add [dir]       Enable the plain-`ls` override for dir (default: .)
#   lsrecent remove [dir]    Disable the override for dir (default: .)
#   lsrecent list            Show all directories with the override enabled
#   lsrecent check [dir]     Exit 0 if dir has the override enabled (quiet;
#                            used by the ls wrapper)
#   lsrecent edit            Open the include-list in $EDITOR
#   lsrecent gui             Same list in a window (needs the lsrecent-gui
#                            companion; also in the app launcher)
#
# Settings (preferences that outlive the shell):
#   lsrecent config          On a terminal: the settings menu — every setting
#                            numbered with its value; type a number to change it
#                            (two-valued ones toggle, sort picks from a list),
#                            d<number> to reset, e for the file. Saved at once.
#                            Also `c` (or /config) at any listing prompt, which
#                            redraws the listing with what you chose.
#   lsrecent config show     Every setting, its value, and where that value is
#                            coming from — the file, an LSRECENT_* variable in
#                            this shell, or the built-in default (also what bare
#                            `config` prints when piped)
#   lsrecent config set <setting> <value>
#   lsrecent config unset <setting>
#   lsrecent config get <setting>
#   lsrecent config edit     The file in $EDITOR
#   lsrecent config path     Where the file is
# The settings, each also an LSRECENT_* variable (LSRECENT_FOCUS_TODAY,
# LSRECENT_PRETTY_NAMES, LSRECENT_SEARCH_ORDER for the last three):
#   sort        recency, frecency, visits or name
#   prompt      1 to end a listing with the browser prompt, 0 for listing only
#   max_rows    rows one listing may occupy, 0 for unlimited
#   noise_pct   share of repos on one inferred day that makes it a bulk touch
#   repo_root   where the repositories are
#   repo_depth  how deep under the root to look for them
#   focus_today repos opened today that make the listing show only today, 0 = never
#   pretty_names 1 to show repo-names-like-this as repo names like this
#   search_order newest (default) puts the most recently touched match first;
#               match ranks whole name, then starts-with, then contains, then path
# A flag beats the environment, the environment beats the file, and the file beats
# the default — so an export is still how you say "just this shell", and the file
# is how you say "always". A setting written while the matching variable is
# exported says so rather than appearing to have taken effect.
#
# Visit log (what "opened" means):
#   lsrecent visit [dir]     Record a visit to dir (the shell hook does this
#                            inline; this is the fallback for other shells)
#   lsrecent prune           Compact the visit log
#
# Shell integration:
#   lsrecent shell-init      Print the bash integration. Add to ~/.bashrc:
#                                eval "$(lsrecent shell-init)"
#
# Config lives in ${XDG_CONFIG_HOME:-~/.config}/lsrecent/dirs — one absolute
# path per line, .../lsrecent/noisy-days — one YYYY-MM-DD per line, `!` in
# front of a day meaning "never suppress this one", and .../lsrecent/config —
# `key = value`, one per line, `#` comments. All three are meant to be edited by
# hand as much as by the commands that write them. A line the settings file gets
# wrong is ignored and reported on every run rather than taken as read: falling
# back to the default in silence is the failure that looks like success. The
# visit log lives in
# ${XDG_DATA_HOME:-~/.local/share}/lsrecent/opened.log — "<epoch>\t<path>", and
# the last listing's numbering in .../lsrecent/last-list — "<n>\t<path>".
#
# Repo root defaults to $LSRECENT_REPO_ROOT, else ~/repos/github, else ~/repos.
# Search depth defaults to $LSRECENT_REPO_DEPTH (4).

VERSION="1.17.0"

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/lsrecent"
config="$config_dir/dirs"
noise_file="$config_dir/noisy-days"
settings_file="$config_dir/config"
state_dir="${XDG_DATA_HOME:-$HOME/.local/share}/lsrecent"
visit_log="$state_dir/opened.log"
sel_map="$state_dir/last-list"

# Whether the listing is bound for a terminal. Has to be sampled here, at the top
# level: inside a $(...) substitution stdout is the pipe bash set up to capture
# the output, so `[[ -t 1 ]]` in a helper called that way is always false.
if [[ -t 1 ]]; then stdout_tty=1; else stdout_tty=0; fi

# The colour the tool speaks in: the footer, the prompt, the help and every
# message the browser prints. It used to be 90 — "bright black" — which on a dark
# terminal is the ink a theme reserves for things you are meant to skim past, and
# the one line saying how to reach the 229 repositories that did not fit is the
# last line that should read as decoration. Orange is legible on a black or a
# white background and collides with nothing else on screen: headers are green,
# cyan, yellow, magenta and grey, entries are blue, and their numbers stay grey
# because there de-emphasis is the point.
#
# 256-colour orange where the terminal admits to having it, plain yellow — the
# nearest an 8-colour palette gets — where it does not. COLORTERM is set by
# essentially every graphical terminal; TERM covers the rest without a fork.
#
# Orange alone was not enough. Every hint line the tool prints is part key and
# part prose — "s sort", "n for the next 20", "sr sort by recency" — and in one
# colour the two halves fuse: the eye has to read the sentence to find the single
# character it is being told to press. So the key gets its own ink (C_KEY) and
# only the key does, which makes the whole help legible as a column of things to
# type with explanations beside them rather than as a paragraph. C_NOW marks the
# state a key would change and is the only green in the hint palette, so "which
# order am I in" is answerable without reading; C_DIM is for separators and
# punctuation, which are structure rather than information.
if [[ "${TERM:-}" == *256color* || "${TERM:-}" == *direct* || -n "${COLORTERM:-}" ]]; then
    C_HINT=$'\e[38;5;214m'      # prose: what a key does, and every plain message
    C_KEY=$'\e[1;38;5;51m'      # the characters you actually type
    C_NOW=$'\e[1;38;5;120m'     # the current setting a key toggles
    C_DIM=$'\e[38;5;244m'       # separators, brackets, arrows
    C_MATCH=$'\e[1;30;48;5;220m' # the characters a search matched, inside a name
else
    C_HINT=$'\e[33m'
    C_KEY=$'\e[1;36m'
    C_NOW=$'\e[1;32m'
    C_DIM=$'\e[90m'
    C_MATCH=$'\e[1;30;43m'
fi
C_OFF=$'\e[0m'
# Today's results in a search list: the one row the eye should land on first.
C_TODAY=$'\e[1;92m'

# Compact the visit log once it grows past this many lines.
PRUNE_THRESHOLD=5000
# Drop visits older than this during a prune.
PRUNE_MAX_AGE_DAYS=180

ensure_config() {
    mkdir -p "$config_dir"
    if [[ ! -f "$config" ]]; then
        cat > "$config" <<'EOF'
# lsrecent include-list: directories where plain `ls` (no arguments) shows the
# grouped-by-recency view. One absolute path per line; ~ is expanded.
# Managed by `lsrecent add|remove|edit` — manual edits are fine too.
EOF
    fi
}

resolve() {
    realpath -- "${1:-$PWD}" 2>/dev/null
}

# Fork-free clock. `date` costs ~7ms a call and this runs on every bare `ls`;
# bash's printf can do both without leaving the process.
now_epoch() {
    printf '%(%s)T' -1
}

# Epoch of today's local midnight, for calendar-day bucketing.
midnight_epoch() {
    local now h m s
    now=$(now_epoch)
    printf -v h '%(%H)T' -1
    printf -v m '%(%M)T' -1
    printf -v s '%(%S)T' -1
    printf '%s' "$(( now - (10#$h * 3600 + 10#$m * 60 + 10#$s) ))"
}

# Snap a timestamp to the nearest local midnight, using bash's own printf for the
# calendar arithmetic so that no `date` is forked.
#
# It iterates because one pass is not enough across a DST change: subtracting the
# wall-clock seconds since midnight assumes the offset has not moved in between, so
# on the day after a transition it lands an hour off — 23:00 the previous evening,
# or 01:00 the same morning. From there the residual points at the real midnight,
# and the second pass reaches it. Snapping to the *nearest* midnight rather than
# always downwards is what makes that converge instead of walking backwards a day
# at a time. Three passes is slack; every real zone settles in two.
#
# Verified exact on all 365 day boundaries of 2026 in Asia/Jerusalem, New_York,
# Sydney, Lord_Howe (30-minute DST), Chatham, Dublin, Kolkata and UTC. The one
# family it cannot be exact for is zones that transition *at* midnight, such as
# America/Santiago, where local midnight either does not exist or happens twice; it
# lands within the hour, which is well inside what recency bucketing cares about.
snap_midnight() {
    local t=$1 h m s secs i
    for i in 1 2 3; do
        printf -v h '%(%H)T' "$t"
        printf -v m '%(%M)T' "$t"
        printf -v s '%(%S)T' "$t"
        secs=$(( 10#$h * 3600 + 10#$m * 60 + 10#$s ))
        (( secs == 0 )) && break
        if (( secs > 43200 )); then t=$(( t + 86400 - secs )); else t=$(( t - secs )); fi
    done
    printf '%s' "$t"
}

# Epoch of yesterday's local midnight, given today's. Snapped from a moment in the
# middle of yesterday rather than reached by subtracting 86400, so a day that a DST
# change made 23 or 25 hours long still yields the right boundary.
yesterday_midnight_epoch() {
    snap_midnight "$(( $1 - 43200 ))"
}

# The local midnights opening the last eight calendar days, newest first, given
# today's: day_mid[0] is today's, [1] yesterday's, … [7] seven days back. Each is
# snapped from midday of the day before rather than reached by subtracting 86400,
# for the same reason as above — walked in steps so that a week containing a DST
# change still yields eight correct boundaries rather than drifting an hour further
# out with every day. Eight snaps, all fork-free.
declare -a day_mid=()
day_midnights() {
    local mid=$1 i
    day_mid=("$mid")
    for (( i = 1; i <= 7; i++ )); do
        mid=$(snap_midnight "$(( mid - 43200 ))")
        day_mid+=("$mid")
    done
}

# The recency window a listing is restricted to: "" (everything), today, or
# yesterday. Both named windows read the visit log only, and both bucket a repo by
# its *newest* visit — which is what makes them disjoint: something opened
# yesterday and again today is today's, and appears in no other list.
window=""
win_lo=0    # inclusive lower bound
win_hi=0    # exclusive upper bound; 0 = none

set_window() {
    window=$1
    local mid; mid=$(midnight_epoch)
    case "$window" in
        today)     win_lo=$mid; win_hi=0 ;;
        yesterday) win_hi=$mid; win_lo=$(yesterday_midnight_epoch "$mid") ;;
        *)         win_lo=0;    win_hi=0 ;;
    esac
}

in_window() {
    (( $1 >= win_lo )) || return 1
    (( win_hi == 0 || $1 < win_hi ))
}

# A timeframe, as `--since` on the command line and `@` at the prompt take it,
# turned into the local midnight it starts at. Sets since_lo and since_label;
# returns 1 for anything it cannot read.
#   today (t)            since this morning's midnight
#   yesterday (y)        yesterday and today
#   week (w), month (m)  the last 7 / 30 calendar days, today included
#   N, Nd                the last N calendar days, today included — 1d is today
#   Nw, Nm               N weeks of 7 days, N months of 30
# Calendar days rather than hours, because the buckets are calendar days: `@2d`
# has to mean "TODAY and YESTERDAY", not "since this time on Saturday".
#
# Unlike --today and --yesterday, this is a cut over the listing's own dates —
# the newer of visit and filesystem — not over the visit log alone, so `@today`
# keeps exactly what is under the TODAY header, and it can be combined with a
# search: the point is "only the repos I have been touching today, matching x".
since_lo=0
since_label=''
parse_since() {
    local spec=${1,,} days mid
    case "$spec" in
        today|t)          days=1 ;;
        yesterday|yest|y) days=2 ;;
        week|w)           days=7 ;;
        month|m)          days=30 ;;
        *)
            [[ "$spec" =~ ^([0-9]+)([dwm]?)$ ]] || return 1
            days=$(( 10#${BASH_REMATCH[1]} ))
            case ${BASH_REMATCH[2]} in
                w) days=$(( days * 7 )) ;;
                m) days=$(( days * 30 )) ;;
            esac ;;
    esac
    (( days >= 1 )) || return 1
    mid=$(midnight_epoch)
    if (( days == 1 )); then
        since_lo=$mid
        since_label="today"
    else
        # Snapped rather than trusted: k * 86400 back from a midnight is an hour
        # off when a DST change falls in between, and snap_midnight goes to the
        # *nearest* midnight, which is the right one.
        since_lo=$(snap_midnight "$(( mid - (days - 1) * 86400 ))")
        if (( days == 2 )); then since_label="since yesterday"
        else since_label="in the last $days days"; fi
    fi
    return 0
}

die() {
    echo "lsrecent: $*" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Override management
# ---------------------------------------------------------------------------

cmd_add() {
    local d; d=$(resolve "$1") || die "no such directory: ${1:-$PWD}"
    [[ -d "$d" ]] || die "not a directory: $d"
    ensure_config
    if grep -qxF "$d" "$config"; then
        echo "lsrecent: already enabled for $d"
    else
        echo "$d" >> "$config"
        echo "lsrecent: enabled for $d"
    fi
}

cmd_remove() {
    local d; d=$(resolve "$1") || d="${1:-$PWD}"
    if [[ -f "$config" ]] && grep -qxF "$d" "$config"; then
        # grep -vxF, not sed: every sed address delimiter is a legal character in
        # a directory name, so a path containing the delimiter would either fail
        # to match or delete the wrong line. -F makes the whole path a literal.
        local tmp; tmp=$(mktemp "${config}.XXXXXX")
        grep -vxF "$d" "$config" > "$tmp" || true
        mv "$tmp" "$config"
        echo "lsrecent: disabled for $d"
    else
        echo "lsrecent: was not enabled for $d"
    fi
}

cmd_list() {
    [[ -f "$config" ]] || return 0
    local line
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        echo "${line/#\~/$HOME}"
    done < "$config"
}

cmd_check() {
    [[ -f "$config" ]] || exit 1

    # Try the unresolved path first. It matches in the overwhelming majority of
    # cases and costs no fork; realpath is only needed when the caller reached
    # the directory through a symlink.
    local raw="${1:-$PWD}" line
    local -a entries=()
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        line="${line/#\~/$HOME}"
        [[ "$raw" == "$line" ]] && exit 0
        entries+=("$line")
    done < "$config"

    (( ${#entries[@]} )) || exit 1
    local d; d=$(resolve "$raw") || exit 1
    [[ "$d" == "$raw" ]] && exit 1
    for line in "${entries[@]}"; do
        [[ "$d" == "$line" ]] && exit 0
    done
    exit 1
}

cmd_edit() {
    ensure_config
    "${EDITOR:-nano}" "$config"
}

# ---------------------------------------------------------------------------
# Settings
#
# Every tunable already existed as an LSRECENT_* environment variable, and a
# variable is the right shape for "this shell, this listing". It is the wrong
# shape for "this is how I like it": four exports in ~/.bashrc are a preference
# recorded in a file about shells, invisible to the tool that obeys it and
# unwritable by it — so `s` at the prompt could find the order you wanted and
# then had nowhere to put it. Hence a file, holding the same settings under
# shorter names.
#
# Precedence is flag, then environment, then file, then built-in default, and it
# falls out of *how* the file is loaded rather than being enforced anywhere:
# load_settings fills in the LSRECENT_* variables that are not already set, and
# every `${LSRECENT_X:-default}` in the rest of the script goes on reading what
# it always read. A variable already in the environment is left exactly as found,
# so an export still wins; flags are parsed afterwards, so a flag wins over both.
#
# The file is read on every run, including the bare `ls` in an override
# directory, so it is parsed in-process — no fork, and no `source`, which would
# make a config file a shell script and a typo in it an arbitrary command.
# ---------------------------------------------------------------------------

# What the file and `lsrecent config` call a setting, against what the script
# reads. Adding a tunable means adding it here and to the three little tables
# below; nothing else in the script has to know the file exists.
declare -A settings_var=(
    [sort]=LSRECENT_SORT
    [prompt]=LSRECENT_PROMPT
    [max_rows]=LSRECENT_MAX_ROWS
    [noise_pct]=LSRECENT_NOISE_PCT
    [repo_root]=LSRECENT_REPO_ROOT
    [repo_depth]=LSRECENT_REPO_DEPTH
    [focus_today]=LSRECENT_FOCUS_TODAY
    [pretty_names]=LSRECENT_PRETTY_NAMES
    [search_order]=LSRECENT_SEARCH_ORDER
)
# Printed in this order. Bash hands back the keys of an associative array in its
# own hash order, which is neither the order they were written in nor stable
# between values, and a settings listing that reshuffles itself is unreadable.
settings_keys=( sort prompt max_rows noise_pct repo_root repo_depth focus_today pretty_names search_order )

setting_desc() {
    case $1 in
        sort)       echo "order inside each group" ;;
        prompt)     echo "end a listing with the browser prompt" ;;
        max_rows)   echo "rows one listing may occupy" ;;
        noise_pct)  echo "share of repos on one inferred day that makes it a bulk touch" ;;
        repo_root)  echo "where the repositories are" ;;
        repo_depth) echo "how deep under the root to look for them" ;;
        focus_today)  echo "repos opened today that make the listing show only today" ;;
        pretty_names) echo "show repo-names-like-this as repo names like this" ;;
        search_order) echo "order of search results" ;;
    esac
}

# What a setting will accept, phrased to be readable at the end of "sort must
# be …". Used by the error, by the generated file's comments and by `config`
# itself, so the three cannot drift apart.
setting_values() {
    case $1 in
        sort)       echo "recency, frecency, visits or name" ;;
        prompt)     echo "0 or 1" ;;
        max_rows)   echo "a number, 0 for unlimited" ;;
        noise_pct)  echo "a number from 0 to 100" ;;
        repo_root)  echo "a path" ;;
        repo_depth) echo "a number" ;;
        focus_today)  echo "a number, 0 to never focus" ;;
        pretty_names) echo "0 or 1" ;;
        search_order) echo "newest or match" ;;
    esac
}

# What the setting is when nobody has said otherwise. Shown rather than assumed:
# "default" next to a blank is a listing that makes you go and read the source to
# find out what it defaults to.
setting_default() {
    case $1 in
        sort)       echo "recency" ;;
        prompt)     echo "1" ;;
        max_rows)   echo "as many as the screen has" ;;
        noise_pct)  echo "50" ;;
        repo_root)  default_root ;;
        repo_depth) echo "4" ;;
        focus_today)  echo "10" ;;
        pretty_names) echo "1" ;;
        search_order) echo "newest" ;;
    esac
}

setting_check() {
    local key=$1 val=$2
    case $key in
        sort)
            # The old spellings are accepted here as they are in LSRECENT_SORT —
            # a value that works in the environment must work in the file, or the
            # file is a second dialect of the same setting.
            case "$val" in
                recency|recent|time|frecency|visits|activity|name) ;;
                *) return 1 ;;
            esac ;;
        prompt|pretty_names) [[ "$val" == 0 || "$val" == 1 ]] || return 1 ;;
        max_rows|repo_depth|focus_today) [[ "$val" =~ ^[0-9]+$ ]] || return 1 ;;
        noise_pct)  [[ "$val" =~ ^[0-9]+$ ]] && (( 10#$val <= 100 )) || return 1 ;;
        repo_root)  [[ -n "$val" ]] || return 1 ;;
        search_order) [[ "$val" == newest || "$val" == match ]] || return 1 ;;
    esac
    return 0
}

# Which settings this run is taking from the file, and everything the file got
# wrong. Collected rather than printed as they are met: the parse runs before the
# command is known, and `check` — the hot path the ls wrapper calls on every
# prompt — has no business printing anything at all.
declare -A settings_from=()
settings_bad=()

load_settings() {
    [[ -f "$settings_file" ]] || return 0
    local line key val var
    while IFS= read -r line || [[ -n "$line" ]]; do
        # A whole-line comment, or blank. An inline comment has to be introduced
        # by whitespace, so a `#` inside a path is part of the path: values here
        # are mostly paths, and a directory may legally contain one.
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
        line=${line%%[[:space:]]#*}
        if [[ "$line" != *=* ]]; then
            settings_bad+=( "not \`key = value\`: $line" )
            continue
        fi
        key=${line%%=*}; val=${line#*=}
        key=${key#"${key%%[![:space:]]*}"}; key=${key%"${key##*[![:space:]]}"}
        val=${val#"${val%%[![:space:]]*}"}; val=${val%"${val##*[![:space:]]}"}

        var=${settings_var[$key]:-}
        if [[ -z "$var" ]]; then
            settings_bad+=( "unknown setting: $key" )
            continue
        fi
        # A bad value in the file is refused rather than passed through to the
        # place that uses it. The environment can afford to die on one — you
        # typed it a second ago — but the file was written weeks back and is read
        # by every bare `ls`, so one stale typo would take the shell prompt with
        # it. It is ignored *and* complained about on every run until fixed;
        # silently falling back to the default is the failure that looks like
        # success.
        if ! setting_check "$key" "$val"; then
            settings_bad+=( "$key must be $(setting_values "$key"): $val" )
            continue
        fi

        # Only where the environment has not already spoken. `+set` rather than
        # `-n`, so that exporting an empty value is still a decision.
        [[ -n "${!var+set}" ]] && continue
        [[ "$key" == repo_root ]] && val=${val/#\~/$HOME}
        printf -v "$var" '%s' "$val"
        settings_from[$key]=1
    done < "$settings_file"
    return 0
}

settings_complain() {
    local msg
    for msg in "${settings_bad[@]}"; do
        printf 'lsrecent: %s: %s\n' "$settings_file" "$msg" >&2
    done
}

ensure_settings() {
    mkdir -p "$config_dir"
    [[ -f "$settings_file" ]] && return 0
    local k
    {
        echo "# lsrecent settings: \`key = value\`, one per line. A \`#\` starts a comment"
        echo "# when it opens the line or follows a space, so a path may contain one."
        echo "#"
        echo "# Written by \`lsrecent config set|unset\`, which preserves hand edits and"
        echo "# comments. The matching LSRECENT_* environment variable wins over anything"
        echo "# here, and a flag on the command line wins over both."
        echo "#"
        for k in "${settings_keys[@]}"; do
            printf '#   %-14s %s — %s\n' "$k" "$(setting_desc "$k")" "$(setting_values "$k")"
        done
    } > "$settings_file"
    return 0
}

# Rewrite the file with $1 set to $2, or removed when $2 is omitted. Line by line
# rather than regenerated from the table: the file is meant to be edited by hand
# as much as by this, and a rewrite that discarded the comments and ordering
# somebody put there would make `config set` the thing you stop using.
write_setting() {
    local key=$1 seen=0 line k
    ensure_settings
    local tmp; tmp=$(mktemp "${settings_file}.XXXXXX") || die "cannot write $settings_file"
    while IFS= read -r line || [[ -n "$line" ]]; do
        k=''
        if [[ ! "$line" =~ ^[[:space:]]*# && "$line" == *=* ]]; then
            k=${line%%=*}
            k=${k#"${k%%[![:space:]]*}"}; k=${k%"${k##*[![:space:]]}"}
        fi
        if [[ "$k" == "$key" ]]; then
            # The first line for a key is the one rewritten and any later one is
            # dropped, so that setting a value cannot leave the file saying two
            # different things. First rather than last because that is the one
            # load_settings takes: it fills a variable that is not already set,
            # so the first line to mention a key is the one that fills it and
            # every later line finds the work done.
            (( seen )) && continue
            seen=1
            (( $# >= 2 )) && printf '%s = %s\n' "$key" "$2"
            continue
        fi
        printf '%s\n' "$line"
    done < "$settings_file" > "$tmp"
    (( seen )) || (( $# < 2 )) || printf '%s = %s\n' "$key" "$2" >> "$tmp"
    mv -f "$tmp" "$settings_file"
}

# The one thing a settings file can do that a variable cannot is be wrong in
# silence — written, believed, and overridden by an export nobody remembers
# making. So every path that writes one says so when it has just been outranked.
#
# Prints on stdout and leaves the redirection to the caller, which is the whole
# of why it takes no destination argument. Passing one and redirecting with
# `> "$out"` looks equivalent and is not: `> /dev/stderr` is an open with
# O_TRUNC, so when stderr is a regular file — a script logging a run, which is
# exactly when nobody is watching — the note lands at offset 0 and eats whatever
# had already been written there. `>&2` at the call site duplicates the existing
# descriptor and appends, and the browser's `> /dev/tty` is unaffected either way.
warn_env_wins() {
    local key=$1 var=${settings_var[$1]}
    [[ -n "${!var+set}" && -z "${settings_from[$key]:-}" ]] || return 0
    printf "${C_HINT}note: ${C_NOW}\$%s${C_HINT} is set in this shell (${C_NOW}%s${C_HINT}) and wins over the file until it is unset${C_OFF}\n" \
        "$var" "${!var}"
}

# Where each setting's value is actually coming from on this run, which is the
# question a settings listing is being read to answer. "sort = visits" in the
# file while $LSRECENT_SORT says otherwise is the one state worth printing, and
# it is invisible unless the origin is printed beside the value.
setting_origin() {
    local key=$1 var=${settings_var[$1]}
    if [[ -n "${settings_from[$key]:-}" ]]; then echo "config"
    elif [[ -n "${!var+set}" ]];         then echo "\$$var"
    else                                      echo "default"
    fi
}

settings_show() {
    local k var val origin
    printf "${C_DIM}%s${C_OFF}\n\n" "$settings_file"
    for k in "${settings_keys[@]}"; do
        var=${settings_var[$k]}
        origin=$(setting_origin "$k")
        if [[ "$origin" == default ]]; then
            val=$(setting_default "$k")
        else
            val=${!var}
        fi
        # One space after the value even when it has overrun its column: a long
        # default like "as many as the screen has" would otherwise be printed
        # welded to the word saying where it came from.
        printf "  ${C_KEY}%-14s${C_NOW}%-26s ${C_DIM}%s${C_OFF}\n" "$k" "$val" "$origin"
        printf "  ${C_DIM}%-14s${C_HINT}%s ${C_DIM}— %s${C_OFF}\n" \
            '' "$(setting_desc "$k")" "$(setting_values "$k")"
    done
    # No settings_complain here: dispatch has already printed the file's bad
    # lines, above this listing, before it knew which command was running.
    printf "\n${C_DIM}→ ${C_KEY}lsrecent config${C_HINT} on its own is a menu ${C_DIM}· ${C_KEY}lsrecent config set ${C_DIM}<${C_HINT}setting${C_DIM}> <${C_HINT}value${C_DIM}> · ${C_KEY}unset ${C_DIM}<${C_HINT}setting${C_DIM}> · ${C_KEY}edit${C_OFF}\n"
    return 0
}

# --- the settings menu --------------------------------------------------------
#
# `lsrecent config` on a terminal, and `c` (or /config) at the listing prompt.
# The point is tinkering: see every setting with its value, pick one by number,
# change it, see the listing change, without remembering a key name or a value
# syntax. Every change is written to the settings file at once, so it outlives
# the shell exactly as `lsrecent config set` would.
#
# Line-oriented like the rest of the browser, and on /dev/tty for the same
# reason: stdout may be a pipe and stdin may be anything.

# The fixed choices a setting has, if it has any. A setting with choices is
# picked from a numbered list (or toggled, when there are two) rather than typed.
setting_choices() {
    case $1 in
        sort)                 echo "recency frecency visits name" ;;
        prompt|pretty_names)  echo "0 1" ;;
        search_order)         echo "newest match" ;;
    esac
}

# The value a setting has on this run, whichever layer it came from.
setting_value() {
    local var=${settings_var[$1]}
    if [[ "$(setting_origin "$1")" == default ]]; then setting_default "$1"; else printf '%s' "${!var}"; fi
}

# Apply a change to this process as well as to the file, so a listing re-drawn
# after the menu shows it. Not where an export outranks the file: there the file
# has changed and this run has not, and warn_env_wins says which variable to
# unset. With no value, back to the default.
setting_apply() {
    local key=$1 var=${settings_var[$1]}
    if [[ -n "${!var+set}" && -z "${settings_from[$key]:-}" ]]; then
        warn_env_wins "$key" > /dev/tty
        return 1
    fi
    if (( $# >= 2 )); then
        printf -v "$var" '%s' "$2"; settings_from[$key]=1
    else
        unset "$var"; unset 'settings_from[$key]'
    fi
    return 0
}

menu_changed=0
settings_menu() {
    local reply i k
    while :; do
        printf "\n${C_HINT}settings ${C_DIM}· saved to %s${C_OFF}\n" "$settings_file" > /dev/tty
        # Sized to the longest value, since a default like "as many as the screen
        # has" or a repo_root path would otherwise weld itself to the next column.
        local -a vals=() ; local w=8
        for k in "${settings_keys[@]}"; do
            vals+=( "$(setting_value "$k")" )
            (( ${#vals[-1]} + 2 > w )) && w=$(( ${#vals[-1]} + 2 ))
        done
        i=0
        for k in "${settings_keys[@]}"; do
            printf "  ${C_KEY}%2d${C_OFF} %-14s${C_NOW}%-*s${C_DIM}%-9s${C_HINT}%s${C_OFF}\n" \
                "$(( i + 1 ))" "$k" "$w" "${vals[i]}" "$(setting_origin "$k")" "$(setting_desc "$k")" > /dev/tty
            (( ++i ))
        done
        printf "${C_DIM}→ ${C_HINT}number to change ${C_DIM}· ${C_KEY}d${C_HINT} number resets it ${C_DIM}(${C_KEY}d3${C_DIM}) · ${C_KEY}e${C_HINT} edit the file ${C_DIM}· ${C_KEY}enter${C_HINT} done${C_DIM}: ${C_OFF}" > /dev/tty
        IFS= read -r reply < /dev/tty || { printf '\n' > /dev/tty; return 0; }
        reply=${reply// /}
        case "$reply" in
            ''|q|Q) return 0 ;;
            e|E)
                ensure_settings
                "${EDITOR:-nano}" "$settings_file" < /dev/tty > /dev/tty
                # Re-read: what the editor wrote is now the file, and the
                # settings_from bookkeeping has to describe it.
                for k in "${settings_keys[@]}"; do
                    [[ -n "${settings_from[$k]:-}" ]] && { local v=${settings_var[$k]}; unset "$v"; }
                done
                settings_from=(); settings_bad=()
                load_settings; settings_complain 2> /dev/tty
                menu_changed=1; continue ;;
            d[0-9]*|D[0-9]*)
                i=${reply:1}
                [[ "$i" =~ ^[0-9]+$ ]] && (( i >= 1 && i <= ${#settings_keys[@]} )) || {
                    printf "${C_HINT}no setting ${C_NOW}%s${C_OFF}\n" "$i" > /dev/tty; continue; }
                k=${settings_keys[i-1]}
                write_setting "$k"
                setting_apply "$k" && menu_changed=1
                printf "${C_HINT}%s is back to its default ${C_DIM}(${C_NOW}%s${C_DIM})${C_OFF}\n" "$k" "$(setting_default "$k")" > /dev/tty
                continue ;;
        esac
        if [[ ! "$reply" =~ ^[0-9]+$ ]] || (( reply < 1 || reply > ${#settings_keys[@]} )); then
            printf "${C_HINT}no setting ${C_NOW}%s${C_DIM} — ${C_HINT}1-%d${C_OFF}\n" "$reply" "${#settings_keys[@]}" > /dev/tty
            continue
        fi
        setting_edit "${settings_keys[reply-1]}"
    done
}

setting_edit() {
    local key=$1 cur val reply i
    cur=$(setting_value "$key")
    local -a ch=( $(setting_choices "$key") )
    if (( ${#ch[@]} == 2 )); then
        # Two values: choosing it is the change. Asking "which of the two?"
        # after you have already said "this one" is a question with one answer.
        [[ "$cur" == "${ch[1]}" ]] && val=${ch[0]} || val=${ch[1]}
    else
        printf "  ${C_HINT}%s ${C_DIM}— %s${C_OFF}\n" "$(setting_desc "$key")" "$(setting_values "$key")" > /dev/tty
        if (( ${#ch[@]} )); then
            printf "  " > /dev/tty
            for i in "${!ch[@]}"; do
                printf "${C_KEY}%d${C_OFF} %s  " "$(( i + 1 ))" "${ch[i]}" > /dev/tty
            done
            printf '\n' > /dev/tty
        fi
        printf "${C_DIM}→ ${C_HINT}new value for ${C_NOW}%s${C_HINT} (now ${C_NOW}%s${C_HINT}) ${C_DIM}· ${C_KEY}d${C_HINT} default ${C_DIM}· ${C_KEY}enter${C_HINT} keeps it${C_DIM}: ${C_OFF}" \
            "$key" "$cur" > /dev/tty
        IFS= read -r reply < /dev/tty || { printf '\n' > /dev/tty; return 0; }
        reply=${reply#"${reply%%[![:space:]]*}"}; reply=${reply%"${reply##*[![:space:]]}"}
        [[ -n "$reply" ]] || return 0
        if [[ "$reply" == d || "$reply" == D ]]; then
            write_setting "$key"
            setting_apply "$key" && menu_changed=1
            printf "${C_HINT}%s is back to its default ${C_DIM}(${C_NOW}%s${C_DIM})${C_OFF}\n" "$key" "$(setting_default "$key")" > /dev/tty
            return 0
        fi
        val=$reply
        if (( ${#ch[@]} )) && [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#ch[@]} )); then
            val=${ch[reply-1]}
        fi
    fi
    if ! setting_check "$key" "$val"; then
        printf "${C_HINT}%s must be %s ${C_DIM}— unchanged${C_OFF}\n" "$key" "$(setting_values "$key")" > /dev/tty
        return 0
    fi
    [[ "$key" == repo_root ]] && val=${val/#\~/$HOME}
    write_setting "$key" "$val"
    setting_apply "$key" "$val" && menu_changed=1
    printf "${C_HINT}saved: ${C_NOW}%s = %s${C_OFF}\n" "$key" "$val" > /dev/tty
    case $key in
        repo_root|repo_depth|noise_pct)
            printf "${C_DIM}  (takes effect from the next listing)${C_OFF}\n" > /dev/tty ;;
    esac
}

# Built by hand rather than with `IFS=', '` and `${settings_keys[*]}`, which
# looks like it joins on both characters and joins on the comma only.
settings_key_list() {
    local out='' k
    for k in "${settings_keys[@]}"; do out+="${out:+, }$k"; done
    echo "$out"
}

cmd_config() {
    local action=${1:-} key=${2:-}
    # Bare `lsrecent config` on a terminal is the menu; piped, or as `config
    # show`, it is the listing it always was.
    if [[ -z "$action" ]]; then
        if [[ -t 1 && -r /dev/tty && -w /dev/tty ]]; then settings_menu; return 0; fi
        action=show
    fi
    case "$action" in
        menu)
            settings_menu ;;
        show|list)
            settings_show ;;
        get)
            [[ -n "$key" ]] || die "which setting? ($(settings_key_list))"
            local var=${settings_var[$key]:-}
            [[ -n "$var" ]] || die "unknown setting: $key ($(settings_key_list))"
            if [[ "$(setting_origin "$key")" == default ]]; then
                setting_default "$key"
            else
                printf '%s\n' "${!var}"
            fi ;;
        set)
            [[ -n "$key" ]] || die "which setting? ($(settings_key_list))"
            [[ -n "${settings_var[$key]:-}" ]] || die "unknown setting: $key ($(settings_key_list))"
            (( $# >= 3 )) || die "no value — \`lsrecent config set $key <$(setting_values "$key")>\`"
            # Checked here as well as at load, because this is the copy of the
            # check that runs while you are still looking at what you typed.
            setting_check "$key" "$3" || die "$key must be $(setting_values "$key"): $3"
            write_setting "$key" "$3"
            printf "lsrecent: %s = %s\n" "$key" "$3"
            warn_env_wins "$key" >&2 ;;
        unset|remove|rm)
            [[ -n "$key" ]] || die "which setting? ($(settings_key_list))"
            [[ -n "${settings_var[$key]:-}" ]] || die "unknown setting: $key ($(settings_key_list))"
            write_setting "$key"
            printf "lsrecent: %s is back to its default (%s)\n" "$key" "$(setting_default "$key")"
            warn_env_wins "$key" >&2 ;;
        edit)
            ensure_settings
            "${EDITOR:-nano}" "$settings_file" ;;
        path)
            printf '%s\n' "$settings_file" ;;
        *)
            die "unknown config command: $action (menu, show, get, set, unset, edit, path)" ;;
    esac
}

# ---------------------------------------------------------------------------
# Bulk-touch days
#
# The list is two-sided on purpose. `noise add` names a day the automatic rule
# missed — a sweep that hit a third of the repos is still a sweep, and only you
# know it was one. `noise remove` names one it caught wrongly, and has to keep
# saying so: an auto-detected day would be re-detected on every listing, so the
# entry is recorded as `!day` — trusted — rather than merely deleted.
# ---------------------------------------------------------------------------

declare -A noise_forced=()   # days the list says to suppress
declare -A noise_trusted=()  # days the list says never to suppress

load_noise_config() {
    noise_forced=(); noise_trusted=()
    [[ -f "$noise_file" ]] || return 0
    local line
    while IFS= read -r line; do
        line=${line%%#*}
        line=${line//[[:space:]]/}
        [[ -n "$line" ]] || continue
        if [[ "$line" == '!'* ]]; then
            noise_trusted[${line#!}]=1
        else
            noise_forced[$line]=1
        fi
    done < "$noise_file"
    return 0
}

# Rewrite the list with $1 removed from both sides, then append $2 if given.
# Whole-file rewrite rather than an append: `add` after `remove` of the same day
# has to drop the `!` line, or the two would contradict each other and the last
# one read would win silently.
write_noise_config() {
    local drop=$1 add=${2:-} day
    mkdir -p "$config_dir"
    local tmp; tmp=$(mktemp "${noise_file}.XXXXXX") || die "cannot write $noise_file"
    {
        echo "# lsrecent bulk-touch days: one YYYY-MM-DD per line, whose inferred"
        echo "# timestamps are ignored. \`!YYYY-MM-DD\` is the opposite — never"
        echo "# suppress that day, however many repos share it."
        for day in "${!noise_forced[@]}"; do
            [[ "$day" == "$drop" ]] && continue
            echo "$day"
        done | sort
        for day in "${!noise_trusted[@]}"; do
            [[ "$day" == "$drop" ]] && continue
            echo "!$day"
        done | sort
        [[ -n "$add" ]] && echo "$add"
    } > "$tmp"
    mv -f "$tmp" "$noise_file"
}

cmd_noise() {
    local action=${1:-list} day=${2:-}
    load_noise_config

    case "$action" in
        list|"")
            local shown=0 d
            if (( ${#noise_forced[@]} )); then
                echo "suppressed by hand:"
                printf '  %s\n' "${!noise_forced[@]}" | sort
                shown=1
            fi
            if (( ${#noise_trusted[@]} )); then
                echo "trusted, never auto-suppressed:"
                printf '  %s\n' "${!noise_trusted[@]}" | sort
                shown=1
            fi

            # The interesting half is what the automatic rule is doing right now,
            # and that is only knowable by running the scan.
            local root; root=$(default_root)
            load_visits
            if collect_repos "$root"; then
                if (( noise_total )); then
                    echo "detected under $root (over ${LSRECENT_NOISE_PCT:-50}% of ${noise_repo_total} repos share a day):"
                    for d in "${!noise_suppressed[@]}"; do
                        printf '  %s — %d repos, listed as UNDATED\n' "$d" "${noise_suppressed[$d]}"
                    done
                    shown=1
                elif (( ${#noise_forced[@]} == 0 )); then
                    echo "nothing suppressed under $root"
                    shown=1
                fi
            fi
            (( shown )) || echo "nothing suppressed, nothing trusted"
            ;;
        add)
            [[ -n "$day" ]] || printf -v day '%(%F)T' -1
            [[ "$day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "not a YYYY-MM-DD day: $day"
            write_noise_config "$day" "$day"
            echo "lsrecent: $day is a bulk touch — its inferred timestamps are ignored"
            ;;
        remove|rm)
            [[ -n "$day" ]] || die "which day? (YYYY-MM-DD)"
            [[ "$day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "not a YYYY-MM-DD day: $day"
            write_noise_config "$day" "!$day"
            echo "lsrecent: $day is trusted again, however many repos share it"
            ;;
        *)
            die "unknown noise command: $action (list, add, remove)"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Visit log
#
# mtime answers "when did this change", not "when did I open it" — cd-ing into
# a repo touches nothing, and editing a nested file leaves the repo directory's
# own mtime alone. The visit log is the only honest source for "opened today",
# so it is recorded by the shell hook on every directory change.
# ---------------------------------------------------------------------------

cmd_visit() {
    local d; d=$(resolve "$1") || return 0
    [[ -e "$d/.git" ]] || return 0
    mkdir -p "$state_dir" 2>/dev/null || return 0
    printf '%s\t%s\n' "$(now_epoch)" "$d" >> "$visit_log" 2>/dev/null
    return 0
}

cmd_prune() {
    [[ -f "$visit_log" ]] || return 0
    local cutoff=$(( $(now_epoch) - PRUNE_MAX_AGE_DAYS * 86400 ))
    local tmp; tmp=$(mktemp "$state_dir/opened.XXXXXX") || return 0
    local -A keep=()
    local t p
    while IFS=$'\t' read -r t p; do
        [[ -n "$p" && "$t" =~ ^[0-9]+$ ]] || continue
        (( t < cutoff )) && continue
        [[ -d "$p" ]] || continue
        (( t > ${keep[$p]:-0} )) && keep[$p]=$t
    done < "$visit_log"
    for p in "${!keep[@]}"; do
        printf '%s\t%s\n' "${keep[$p]}" "$p"
    done | sort -n > "$tmp"
    mv -f "$tmp" "$visit_log"

    # Reply files from shells that died between the prompt and the cd. Harmless —
    # a PID is reused only after the file has been removed by the next listing in
    # that shell — but there is no reason to keep them.
    find "$state_dir" -maxdepth 1 -name 'cd.*' -mtime +1 -delete 2>/dev/null
    return 0
}

declare -A opened_ts=()
# Every visit, not just the newest: "how often" is a different question from
# "when last", and the activity sort asks the first one. Kept as a space-joined
# string per path because bash has no array of arrays; the log is compacted at
# PRUNE_THRESHOLD, so this is bounded by that rather than by how long the log has
# existed. Note that prune keeps one line per repo, so counts only distinguish
# repos within the un-pruned tail — which is the window the sort cares about.
declare -A visit_times=()

load_visits() {
    opened_ts=(); visit_times=()
    [[ -f "$visit_log" ]] || return 0
    local lines
    lines=$(wc -l < "$visit_log" 2>/dev/null) || lines=0
    (( lines > PRUNE_THRESHOLD )) && cmd_prune
    local t p
    while IFS=$'\t' read -r t p; do
        [[ -n "$p" && "$t" =~ ^[0-9]+$ ]] || continue
        (( t > ${opened_ts[$p]:-0} )) && opened_ts[$p]=$t
        visit_times[$p]+="$t "
    done < "$visit_log"
}

# ---------------------------------------------------------------------------
# Repository discovery
# ---------------------------------------------------------------------------

default_root() {
    local r
    for r in "${LSRECENT_REPO_ROOT:-}" "$HOME/repos/github" "$HOME/repos"; do
        [[ -n "$r" && -d "$r" ]] && { echo "$r"; return; }
    done
    echo "$PWD"
}

declare -A repo_ts=()
# Repos whose only date came from a day ruled a bulk touch. They keep a place in
# the listing — dropping a repo because its date is untrustworthy would be worse
# than mis-dating it — with repo_ts 0, which buckets them under UNDATED.
declare -A repo_undated=()
# "YYYY-MM-DD" -> how many repos that day cost, for the footer and `noise list`.
declare -A noise_suppressed=()
noise_total=0
noise_repo_total=0

# Populates repo_ts[abs_path] = best-known "last touched" epoch, the newest of:
#
#   the recorded visit          you opened it — the only direct evidence
#   the repo directory's mtime  a file was added or removed at the top level
#   .git/logs/HEAD's mtime      HEAD moved: a commit, checkout, merge, pull, reset
#
# Deliberately NOT the mtime of the .git directory itself, which is what this
# used until 1.11.0. A directory's mtime moves when an entry inside it is created
# or removed, so every lock file, every `gc.log`, every temp file any tool writes
# next to the index counts as "I worked here" — and a command run across every
# repo makes all of them today's. Measured on this machine on 2026-08-08, a single
# sweep at 18:59 had moved the .git mtime of 300 of 303 repos while the worktree
# mtime had moved for 14 and logs/HEAD for 15.
#
# Also deliberately not .git/index, which `git status` rewrites — 66 repos on that
# same day — nor .git/FETCH_HEAD: a fetch is not work, and `git fetch` run across
# every repo is precisely the sweep this is trying not to be fooled by. A pull
# moves HEAD and is caught by the reflog regardless.
collect_repos() {
    local root=$1
    local depth=${LSRECENT_REPO_DEPTH:-4}
    repo_ts=(); repo_undated=(); noise_suppressed=(); noise_total=0

    # -mindepth 2 skips "$root/.git", so a root that is itself a repo is not
    # listed among the repos under it. It also keeps every emitted path strictly
    # below $root, which is what sorted_repos' prefix strip assumes.
    #
    # find emits both paths it wants stat'd per repo and they go straight down a
    # pipe, never through a bash array: this is the hot path — it runs on every
    # bare `ls` in a repo-grouping directory — and materialising six hundred paths
    # only to expand them back out as arguments costs more than the stat does.
    # xargs also keeps the argument list bounded, which one `stat` argv would not:
    # two paths per repo reaches ARG_MAX in the tens of thousands of repos, and
    # the failure there looks like nothing rather than like an error, since stat's
    # complaint goes to a suppressed stderr and every repo comes back undated.
    #
    # A missing reflog — a repo with no commits — simply produces no line, and the
    # worktree mtime stands alone. The worktree line always arrives, so counting
    # those counts the repos.
    local -A inferred=()
    local m p
    while IFS='|' read -r m p; do
        [[ -n "$p" ]] || continue
        if [[ "$p" == */.git/logs/HEAD ]]; then
            p=${p%/.git/logs/HEAD}
        else
            (( noise_repo_total++ ))
        fi
        (( m > ${inferred[$p]:-0} )) && inferred[$p]=$m
    done < <(find "$root" -mindepth 2 -maxdepth "$depth" -name .git -prune \
                  -printf '%h\0%h/.git/logs/HEAD\0' 2>/dev/null \
             | xargs -0 stat -c '%Y|%n' -- 2>/dev/null)

    (( noise_repo_total )) || return 1

    # Which calendar days are bulk touches. Counted over inferred dates only: the
    # visit log records what you opened, and a command run across every repo opens
    # nothing, so a day you genuinely spent in fifty repos is not at risk here.
    local pct=${LSRECENT_NOISE_PCT:-50}
    [[ "$pct" =~ ^[0-9]+$ ]] || die "LSRECENT_NOISE_PCT must be a number: $pct"
    local -A day_count=()
    local day
    for p in "${!inferred[@]}"; do
        printf -v day '%(%F)T' "${inferred[$p]}"
        (( day_count[$day]++ ))
    done
    load_noise_config
    local limit=0
    (( pct > 0 )) && limit=$(( noise_repo_total * pct / 100 ))
    local -A noisy=()
    for day in "${!day_count[@]}"; do
        (( limit > 0 && day_count[$day] > limit )) || continue
        [[ -v noise_trusted[$day] ]] && continue
        noisy[$day]=1
    done
    for day in "${!noise_forced[@]}"; do
        noisy[$day]=1
    done

    local -A quarantined=()
    for p in "${!inferred[@]}"; do
        printf -v day '%(%F)T' "${inferred[$p]}"
        if [[ -v noisy[$day] ]]; then
            quarantined[$p]=$day
        else
            repo_ts[$p]=${inferred[$p]}
        fi
    done

    for p in "${!opened_ts[@]}"; do
        [[ -v inferred[$p] ]] || continue
        (( opened_ts[$p] > ${repo_ts[$p]:-0} )) && repo_ts[$p]=${opened_ts[$p]}
    done

    # A quarantined repo you also opened that day is dated by the visit and is not
    # undated at all — which is the point of suppressing the signal rather than the
    # repo. Only what the sweep was the sole evidence for ends up here.
    for p in "${!quarantined[@]}"; do
        [[ -v repo_ts[$p] ]] && continue
        repo_undated[$p]=1
        repo_ts[$p]=0
        day=${quarantined[$p]}
        (( noise_suppressed[$day]++ ))
        (( noise_total++ ))
    done

    # Explicit: without it the function returns the status of the arithmetic
    # above, so a visit that is merely not newer than the mtime reads as "no
    # repositories found" at every call site.
    return 0
}

# True if a git repo exists strictly below $1, without walking the whole tree —
# -quit stops at the first hit, which is the normal case.
has_nested_repo() {
    local hit
    hit=$(find "$1" -mindepth 2 -maxdepth "${LSRECENT_REPO_DEPTH:-4}" \
               -name .git -print -quit 2>/dev/null)
    [[ -n "$hit" ]]
}

# Emits "<epoch>\t<path relative to root>", newest first. With opened_only set,
# only repos with a recorded visit are emitted, timestamped by that visit —
# "when did I open this", with mtime ignored entirely. That is one timestamp per
# repo, the newest, which is what keeps the today and yesterday windows disjoint.
sorted_repos() {
    local root=$1 opened_only=${2:-0} p
    for p in "${!repo_ts[@]}"; do
        if (( opened_only )); then
            [[ -v opened_ts[$p] ]] || continue
            printf '%s\t%s\n' "${opened_ts[$p]}" "${p#"$root"/}"
        else
            printf '%s\t%s\n' "${repo_ts[$p]}" "${p#"$root"/}"
        fi
    done | sort -rn
}

# ---------------------------------------------------------------------------
# Presentation
# ---------------------------------------------------------------------------

term_cols() {
    echo "${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
}

print_header() {
    local color=$1 label=$2 cols=$3 fill
    local pad=$(( cols - ${#label} - 6 ))
    (( pad < 3 )) && pad=3
    printf -v fill '%*s' "$pad" ''
    printf '\e[1;%sm━━ %s ━%s\e[0m\n' "$color" "$label" "${fill// /━}"
}

# Numbering state. sel_n counts up across groups so a repo's number is unique in
# the whole listing, not just its bucket; sel_total is only needed to size the
# number column before the first group prints.
declare -a sel_paths=()
# The label as displayed ("topic/repo"), kept beside the path so the browser can
# re-render an entry that the first screenful never printed. Without it a search
# could find a hidden entry but have nothing to show for it but its full path.
declare -a sel_names=()
sel_n=0
sel_total=0
sel_shown=0

# How wide a group's columns must be and how many fit on a row. Split out of the
# printing so a group's row count is known *before* anything is emitted, which is
# what lets the row budget below decide where to stop.
pn_per=1
pn_numw=2
pn_namew=2
plan_columns() {
    local cols=$1; shift
    local e n max=0
    for e; do
        n=${e%%$'\t'*}
        (( ${#n} > max )) && max=${#n}
    done
    pn_numw=${#sel_total}
    (( pn_numw < 2 )) && pn_numw=2
    pn_namew=$(( max + 2 ))
    pn_per=$(( cols / (pn_numw + 2 + pn_namew) ))
    (( pn_per < 1 )) && pn_per=1
}

# Column-pack pre-ordered "display<TAB>abspath" entries, numbering as it goes.
# Call plan_columns for the same group first. `ls -C` cannot be reused at repo
# level: it re-sorts operands (or, with -U, only preserves order for names it can
# resolve from one directory), and repos live under many different parents.
# Filling row-major matters now that entries are numbered — column-major would
# print 1, 2, 3 down the page instead of across.
pack_numbered() {
    (( $# )) || return 0
    local e n path i=0
    for e; do
        n=${e%%$'\t'*}
        path=${e#*$'\t'}
        (( ++sel_n ))
        sel_paths[sel_n]=$path
        sel_names[sel_n]=$n
        printf '\e[90m%*d\e[0m ' "$pn_numw" "$sel_n"
        # Lit up here as well as in the browser: a listing narrowed by a search on
        # the command line is the same answer arriving by a different door, and the
        # part that matched is the reason each row is on the screen.
        print_label "$n" "$list_filter" "$pn_namew"
        (( ++i % pn_per == 0 )) && printf '\n'
    done
    (( i % pn_per )) && printf '\n'
    return 0
}

# Number the entries that did not fit, without printing them. The listing is cut
# to one screenful but the ranking behind it is not, so a repo below the fold
# still gets a number and "23" resolves whether or not 23 was on screen. Without
# this the numbering stopped at the fold, which made every repo past the twentieth
# unreachable by the one mechanism the tool exists for. Only ever called after the
# last printed group — once anything is elided nothing later prints — so appending
# here cannot disturb the numbers already shown.
register_hidden() {
    local e
    for e; do
        (( ++sel_n ))
        sel_paths[sel_n]=${e#*$'\t'}
        sel_names[sel_n]=${e%%$'\t'*}
    done
    return 0
}

# Rows a listing may occupy. 0 means unlimited, which is also what a redirected
# stdout gets: a pipe should receive the whole listing, the same way `ls` drops
# its columns when it is not talking to a terminal.
row_budget() {
    local override=${LSRECENT_MAX_ROWS:-}
    if [[ -n "$override" ]]; then
        [[ "$override" =~ ^[0-9]+$ ]] || die "LSRECENT_MAX_ROWS must be a number: $override"
        echo "$override"
        return 0
    fi
    (( stdout_tty )) || { echo 0; return 0; }
    # LINES comes from shell-init. Falling back to `stty size` on /dev/tty rather
    # than `tput lines` for the same reason as above: tput sizes the terminal from
    # an ioctl on its own stdout, which here is a pipe, so it would answer with
    # terminfo's static default instead of the real height.
    local rows=${LINES:-}
    if [[ -z "$rows" ]]; then
        rows=$( { stty size < /dev/tty; } 2>/dev/null )
        rows=${rows%% *}
    fi
    [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
    # Spend at most the visible screen, leaving the prompt and the "N more"
    # footer somewhere to land.
    echo $(( rows > 6 ? rows - 3 : 3 ))
}

# Persist the numbering so the shell's number-functions can resolve it after the
# listing process has exited. Written once per listing, replacing the last one.
write_sel_map() {
    (( ${#sel_paths[@]} )) || return 0
    mkdir -p "$state_dir" 2>/dev/null || return 0
    local tmp i
    tmp=$(mktemp "$state_dir/last-list.XXXXXX") || return 0
    for i in "${!sel_paths[@]}"; do
        printf '%s\t%s\n' "$i" "${sel_paths[$i]}"
    done > "$tmp"
    mv -f "$tmp" "$sel_map" 2>/dev/null
    return 0
}

# Said instead of prompting when the listing cannot be answered. A missing prompt
# is the one failure this tool can have that looks like no failure at all — the
# numbers print, nothing asks for one, and nothing on screen explains why — and
# its usual cause is a shell still running functions it eval'd before the binary
# was upgraded underneath it, sometimes days before. Hence the version handshake:
# shell-init exports the version that defined the functions, and a shell that
# exported nothing predates the handshake, so is stale by definition.
stale_integration_notice() {
    local loaded=${LSRECENT_SHELL:-} why
    [[ "$loaded" != "$VERSION" ]] || return 0
    if [[ -n "$loaded" ]]; then
        why="shell has $loaded, binary is $VERSION"
    else
        why="not loaded in this shell"
    fi
    printf "${C_DIM}→ ${C_HINT}cd-by-number needs the shell integration reloaded ${C_DIM}(${C_NOW}%s${C_DIM}) — ${C_KEY}source ~/.bashrc${C_HINT}, or open a new terminal${C_OFF}\n" \
        "$why"
}

# Ask which entry to cd into, straight after printing the listing. Interactive is
# the default because a numbered listing is a question, and the numbers are only
# useful while they are still on the screen above the cursor.
#
# The prompt talks to /dev/tty, not stdin/stdout: stdin may be anything, and
# stdout is the listing itself (possibly a pipe). The answer leaves by a third
# channel again — the file named in $LSRECENT_CD_FILE — because a process cannot
# cd its parent shell; the shell function that set the variable does that. With
# the variable unset there is nobody to act on a choice, so the notice above
# stands in for the prompt rather than a question nothing could honour: that
# covers both a stale shell and `lsrecent repos` run straight from argv, where
# typing a number would not work either.
# Whether prompt_jump will actually ask, rather than print the notice or nothing.
will_prompt() {
    (( stdout_tty )) || return 1
    [[ "${LSRECENT_PROMPT:-1}" != 0 ]] || return 1
    [[ -n "${LSRECENT_CD_FILE:-}" ]] || return 1
    [[ -r /dev/tty && -w /dev/tty ]]
}

prompt_jump() {
    local dest=${LSRECENT_CD_FILE:-}
    (( stdout_tty )) || return 0
    [[ "${LSRECENT_PROMPT:-1}" != 0 ]] || return 0
    (( ${#sel_paths[@]} )) || return 0
    [[ -n "$dest" ]] || { stale_integration_notice; return 0; }
    [[ -r /dev/tty && -w /dev/tty ]] || return 0

    browse "$dest"
}

# --- the browser -------------------------------------------------------------
#
# What turns the listing from a screenful into something you cannot fail to get an
# answer out of. The first screenful is the twenty most recent repositories; the
# ranking behind it is often hundreds long, and before this the only ways to reach
# #237 were to abandon the listing for `lsrepos --all` or for fzf. Now the same
# prompt that takes a number also takes a search, and pages.
#
# It stays line-oriented on purpose. A full-screen alternate-screen TUI would be
# the conventional answer, but this tool's whole premise is that the listing lands
# in your scrollback and stays there — the numbers are useful precisely because
# they are still above the cursor after you have moved on. An app that clears the
# screen on exit throws that away, so each page is printed and scrolls like any
# other command output.
#
# `view` holds ranking positions, never entries. Filtering and paging therefore
# cannot renumber anything: 237 is the 237th entry of the listing — the same
# repository on the first screen, inside a search, and in `lsrecent path 237`
# afterwards.
declare -a view=()
view_from=0
view_filter=''
# A timeframe over the view (`@today`, `@3d` at the prompt): an epoch, 0 for none.
view_since=0
view_since_label=''
# Where the next page has to stop short of the end of the view: set to focus_n
# while enter is paging through a busy day's TODAY, so that "more" means more of
# today and the older repos do not spill onto the same page. 0 = the end.
page_stop=0
# Where the page most recently printed began. `p` needs it: the page before this
# one starts one page-length further back, and nothing else records where "this
# one" started once view_from has moved past its end.
page_start=0

# How well a repo answers what you typed. Sets `match_tier` — 0 for no match,
# then 1 (best) to 4 — rather than echoing it, because this runs once per entry
# and a command substitution there is a fork per repo.
#
# Label and path are both searched: "noisy" should find the repo, and
# "smart-home" should find everything filed under that topic even though the
# topic is only part of some labels. But they are not equally good answers, which
# is the whole point of the tiers. Typing `wms` at a listing of 315 repositories
# and getting `Wheres-My-Stuff` fourth, under three repos whose *paths* happen to
# contain the letters, is the search failing while appearing to work.
#
# The needle must already be folded by the caller (fold_needle) — done once there
# rather than 315 times here.
#
# Hyphens, underscores and spaces are folded to one character on both sides. Labels
# print as "Wheres My Stuff" when pretty_names is on, and the directory is
# Wheres-My-Stuff either way; typing what you see, or what the directory is called,
# has to find it in both cases. The fold is one character for one, so the offsets
# print_label highlights are the same in the folded and the printed label.
match_tier=0
match_tier() {
    local label=$1 path=$2 needle=$3 low=${1,,}
    low=${low//[-_]/ }
    path=${path//[-_]/ }
    if   [[ "$low" == "$needle" ]];   then match_tier=1   # the whole name
    elif [[ "$low" == "$needle"* ]];  then match_tier=2   # starts with it
    elif [[ "$low" == *"$needle"* ]]; then match_tier=3   # contains it
    elif [[ "${path,,}" == *"$needle"* ]]; then match_tier=4   # only the path does
    else match_tier=0
    fi
    (( match_tier ))
}

fold_needle() {
    local n=${1,,}
    printf '%s' "${n//[-_]/ }"
}

# Whether ranking entry $1 is dated at or after view_since. The date is the one
# the listing bucketed it by — the visit log alone under lstoday/lsyesterday, the
# newer of visit and filesystem otherwise — so `@today` at the prompt keeps
# exactly what is under the TODAY header above it, no more and no fewer.
entry_since() {
    entry_ts "$1"
    (( ets >= view_since ))
}

# The date ranking entry $1 is listed by, into `ets` (no fork: once per entry).
ets=0
entry_ts() {
    local p=${sel_paths[$1]}
    if [[ -n "$window" ]]; then ets=${opened_ts[$p]:-0}; else ets=${repo_ts[$p]:-0}; fi
}

# Whether the view is an answer to a question — a search at the prompt, one given
# on the command line, or a timeframe — rather than the listing itself. A narrowed
# view prints as the cursor list (render_list_page) and enter takes the cursor.
view_narrowed() {
    [[ -n "$view_filter$view_since_label$list_filter" ]]
}

# The cursor: a position in `view` (not an entry number), -1 for none. Put on the
# first result whenever a narrowed view is built, so a search followed by enter
# goes to the top result without anything being typed back.
cursor=-1
# Whether the view runs newest-first, so that today's results are one block at
# the top and can sit under a TODAY bar. False only under search_order = match.
view_chrono=1

# Newest first, by the date the entry is listed under; ties keep listing order.
# One sort over the matches rather than a comparison sort in bash: a search is
# typed by hand, so one fork per search costs nothing anyone can see.
sort_view_newest() {
    (( ${#view[@]} > 1 )) || return 0
    local i
    local -a keyed=()
    for i in "${view[@]}"; do
        entry_ts "$i"
        keyed+=( "$ets"$'\t'"$i" )
    done
    mapfile -t view < <(printf '%s\n' "${keyed[@]}" | sort -t$'\t' -k1,1nr -k2,2n | cut -f2)
}

# The view, ranked when there is a search and in listing order when there is not.
#
# Ranking is four passes rather than a sort: it costs no fork, and within a tier
# the listing's own order survives — so the best match is at the top and the rest
# are still newest-first (or whatever `s` last chose) underneath it, instead of
# being re-shuffled by a scoring function nobody can see.
build_view() {
    view=()
    local i needle
    needle=$(fold_needle "$view_filter")
    if [[ -z "$needle" ]]; then
        for (( i = 1; i <= sel_n; i++ )); do
            [[ -n "${sel_names[i]:-}" ]] || continue
            (( view_since == 0 )) || entry_since "$i" || continue
            view+=( "$i" )
        done
    else
        local -a tier1=() tier2=() tier3=() tier4=()
        for (( i = 1; i <= sel_n; i++ )); do
            [[ -n "${sel_names[i]:-}" ]] || continue
            (( view_since == 0 )) || entry_since "$i" || continue
            match_tier "${sel_names[i]}" "${sel_paths[i]}" "$needle" || continue
            case $match_tier in
                1) tier1+=( "$i" ) ;;
                2) tier2+=( "$i" ) ;;
                3) tier3+=( "$i" ) ;;
                *) tier4+=( "$i" ) ;;
            esac
        done
        view=( "${tier1[@]}" "${tier2[@]}" "${tier3[@]}" "${tier4[@]}" )
    fi
    # Newest first is the default for a search: the repo you were in an hour ago
    # is the one you are looking for far more often than the one whose name
    # happens to match best. search_order = match keeps the tiers above.
    view_chrono=1
    if [[ -n "$needle$list_filter" ]]; then
        if [[ "${lr_search_order:-newest}" == match ]]; then
            [[ -n "$needle" ]] && view_chrono=0
        else
            sort_view_newest
        fi
    fi
    cursor=-1
    view_narrowed && (( ${#view[@]} )) && cursor=0
    view_from=0
    page_start=0
    plan_view_layout
}

# Column widths and page length for the current view, measured over the whole of
# it rather than over the slice about to be printed, and once per view rather
# than once per page. With $1, over only the first $1 entries: a busy day's TODAY
# is paged by enter as a region of its own, and measured against seven hundred
# labels it would print one long name per row.
#
# That is what makes paging reversible. Sized off the visible slice, the number of
# entries on a page depended on the longest label still *ahead* of it, so page
# boundaries moved depending on where you started from and `p` could not land back
# on the page you had just left. A fixed length per view also means the columns
# line up from one page to the next, and that the page before this one begins at
# exactly page_start - vp_page.
vp_per=1
vp_numw=2
vp_namew=2
vp_page=0   # entries per page; 0 = no budget, the whole view is one page
plan_view_layout() {
    local i label max=0 cols budget lim=${1:-${#view[@]}}
    (( lim > ${#view[@]} )) && lim=${#view[@]}
    for (( i = 0; i < lim; i++ )); do
        label=${sel_names[${view[i]}]}
        (( ${#label} > max )) && max=${#label}
    done
    cols=$(term_cols)
    vp_numw=${#sel_n}
    (( vp_numw < 2 )) && vp_numw=2
    vp_namew=$(( max + 2 ))
    vp_per=$(( cols / (vp_numw + 2 + vp_namew) ))
    (( vp_per < 1 )) && vp_per=1
    budget=$(row_budget)
    vp_page=0
    (( budget > 0 )) && vp_page=$(( budget * vp_per ))
    # The cursor list is one entry per row, and spends two rows of the budget on
    # its TODAY / EARLIER bars.
    if view_narrowed; then
        vp_per=1
        vp_page=0
        (( budget > 0 )) && vp_page=$(( budget > 4 ? budget - 2 : 2 ))
    fi
    return 0
}

# One entry's label, padded to $3, with the part that matched $2 lit up. Without
# the highlight a filtered listing is a list of names that all look equally like
# an answer, and the reason a row is there — which for a path-only match is not
# in the row at all — has to be reconstructed by reading. With it, the answer is
# where your eye already is.
#
# The padding is done here rather than by `%-*s` because the label is printed in
# three pieces and the escape sequences between them would be counted as width.
# A path-only match has nothing to light up in the label, so it prints plain: the
# absence of a highlight is itself the signal that the name did not match.
print_label() {
    local label=$1 needle=$2 width=$3 low=${1,,} pre base=${4:-$'\e[01;34m'}
    low=${low//[-_]/ }
    needle=${needle//[-_]/ }
    if [[ -z "$needle" || "$low" != *"$needle"* ]]; then
        printf '%s%s\e[0m%*s' "$base" "$label" "$(( width - ${#label} ))" ''
        return 0
    fi
    pre=${low%%"$needle"*}
    printf '%s%s\e[0m%s%s\e[0m%s%s\e[0m%*s' \
        "$base" "${label:0:${#pre}}" \
        "$C_MATCH" "${label:${#pre}:${#needle}}" \
        "$base" "${label:$(( ${#pre} + ${#needle} ))}" \
        "$(( width - ${#label} ))" ''
}

# Print one page of `view` starting at view_from, and advance it. With $1 set,
# print the lot regardless of the row budget.
render_page() {
    local unlimited=${1:-}
    local total=${#view[@]}
    if (( total == 0 )); then
        if [[ -n "$view_filter" ]]; then
            printf "${C_HINT}nothing matches ${C_NOW}\"%s\"%s${C_DIM} — ${C_KEY}/${C_HINT} on its own clears the search${C_OFF}\n" \
                "$view_filter" "${view_since_label:+ ${view_since_label}}" > /dev/tty
        else
            printf "${C_HINT}nothing touched ${C_NOW}%s${C_DIM} — ${C_KEY}@${C_HINT} on its own clears the timeframe${C_OFF}\n" \
                "$view_since_label" > /dev/tty
        fi
        return 0
    fi

    if view_narrowed; then
        render_list_page "$unlimited"
        return 0
    fi

    local stop=$total
    (( page_stop > 0 && page_stop < total )) && stop=$page_stop
    local cap=$(( stop - view_from ))
    [[ -n "$unlimited" ]] || (( vp_page == 0 || vp_page >= cap )) || cap=$vp_page

    page_start=$view_from
    local i n printed=0 needle=${view_filter,,}
    for (( i = view_from; i < view_from + cap; i++ )); do
        n=${view[i]}
        printf '\e[90m%*d\e[0m ' "$vp_numw" "$n" > /dev/tty
        print_label "${sel_names[n]}" "$needle" "$vp_namew" > /dev/tty
        (( ++printed % vp_per == 0 )) && printf '\n' > /dev/tty
    done
    (( printed % vp_per )) && printf '\n' > /dev/tty

    local first=$(( page_start + 1 )) last=$(( page_start + printed ))
    view_from=$last
    local scope='' nav
    [[ -n "$view_filter" ]] && scope="${C_HINT} matching ${C_NOW}\"$view_filter\""
    [[ -n "$view_since_label" ]] && scope+="${C_HINT} touched ${C_NOW}$view_since_label"
    # Paging through a busy day's TODAY with enter: say how much of today is left,
    # and that enter is still the key, until today runs out.
    if (( page_stop > 0 )); then
        if (( view_from < page_stop )); then
            printf -v nav "${C_DIM} · ${C_KEY}enter${C_HINT} for the next %d" \
                "$(( page_stop - view_from < printed ? page_stop - view_from : printed ))"
        else
            nav="${C_DIM} · ${C_HINT}that is all of today${C_DIM} · ${C_KEY}n${C_HINT} goes on to older ones"
        fi
        (( page_start > 0 )) && nav+="${C_DIM} · ${C_KEY}p${C_HINT} for the page before"
        printf "${C_DIM}… ${C_NOW}%d-%d${C_HINT} of ${C_NOW}%d${C_HINT} today%s${C_OFF}\n" \
            "$first" "$last" "$page_stop" "$nav" > /dev/tty
        return 0
    fi
    # A search that leaves exactly one repository has already answered the
    # question, and making you read its number off the screen and type it back is
    # the one thing this prompt exists not to do. Enter takes it. Enter otherwise
    # still means "stay put", so the offer is only ever made on the line that
    # explains it — never silently.
    if [[ -n "$view_filter$view_since_label" ]] && (( total == 1 )); then
        printf "${C_DIM}… ${C_HINT}the only match${C_DIM} · ${C_KEY}enter${C_HINT} goes there${C_DIM} · ${C_KEY}/${C_HINT} clears the search${C_OFF}\n" \
            > /dev/tty
        return 0
    fi
    if (( view_from < total )); then
        printf -v nav "${C_DIM} · ${C_KEY}n${C_HINT} for the next %d" \
            "$(( total - view_from < printed ? total - view_from : printed ))"
    else
        nav="${C_DIM} · ${C_HINT}end"
    fi
    (( page_start > 0 )) && nav+="${C_DIM} · ${C_KEY}p${C_HINT} for the page before"
    printf "${C_DIM}… ${C_NOW}%d-%d${C_HINT} of ${C_NOW}%d%s%s${C_OFF}\n" \
        "$first" "$last" "$total" "$scope" "$nav" > /dev/tty
}

# --- the cursor list ----------------------------------------------------------
#
# A narrowed view — a search, a timeframe — prints one result per row instead of
# packed columns: a cursor needs somewhere unambiguous to be, and "down" has to
# mean the next result. Each row carries when it was last touched, because "the
# one I had open this morning" is how most searches are actually meant, and
# today's results sit under a TODAY bar with their time lit up in green.
#
#   ━━ TODAY ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#   ▶ 4  Laptop Search      ● today 11:26      ~/repos/github/tools/Laptop-Search
#     9  Laptop Setup       ● today 09:02      ~/repos/github/linux/Laptop-Setup
#   ━━ EARLIER ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#    31  Old Laptop Notes   Oct 28             ~/repos/github/notes/Old-Laptop-Notes
#
# Moving the cursor redraws the page in place (cursor-up, reprint) rather than
# printing it again, so arrowing through ten results leaves one copy in the
# scrollback, not ten. Every row is cut to the terminal width so that the number
# of rows to go back up is known exactly; a page that would not fit on the screen
# (`a`, everything unpaged) is reprinted below instead.

# A label for when an entry was last touched, into `when`; `when_today` = 1 for
# today. printf's %(...)T is a builtin, so this costs no fork per row.
when='' when_today=0
when_label() {
    local ts=$1 y_ts y_now
    when_today=0
    if (( ts == 0 )); then
        when='undated'
    elif (( ts >= day_mid[0] )); then
        printf -v when '● today %(%H:%M)T' "$ts"; when_today=1
    elif (( ts >= day_mid[1] )); then
        printf -v when 'yesterday %(%H:%M)T' "$ts"
    elif (( ts >= day_mid[6] )); then
        printf -v when '%(%a %H:%M)T' "$ts"
    else
        printf -v y_ts '%(%Y)T' "$ts"; printf -v y_now '%(%Y)T' -1
        if [[ "$y_ts" == "$y_now" ]]; then printf -v when '%(%b %e)T' "$ts"
        else printf -v when '%(%Y-%m-%d)T' "$ts"
        fi
    fi
}

# Terminal rows, for deciding whether a page can be redrawn in place.
term_rows() {
    local rows=${LINES:-}
    if [[ -z "$rows" ]]; then
        rows=$( { stty size < /dev/tty; } 2>/dev/null )
        rows=${rows%% *}
    fi
    [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
    echo "$rows"
}

# Screen rows a line of hint text takes at width $2, into `vis_rows`. Only for
# lines built from the C_* colours, whose escapes all end in `m`.
vis_rows=1
count_vis_rows() {
    local s=$1 cols=$2 out=''
    while [[ "$s" == *$'\e['* ]]; do
        out+=${s%%$'\e['*}
        s=${s#*$'\e['}
        s=${s#*m}
    done
    out+=$s
    vis_rows=$(( (${#out} + cols - 1) / cols ))
    (( vis_rows < 1 )) && vis_rows=1
    return 0
}

# Rows the last drawn list block took (bars, entries, footer), for the redraw.
lb_rows=0

# Print a page of the cursor list from view_from and advance it. With $1 set,
# the whole view regardless of the row budget.
render_list_page() {
    local unlimited=${1:-} total=${#view[@]}
    local cap=$(( total - view_from ))
    [[ -n "$unlimited" ]] || (( vp_page == 0 || vp_page >= cap )) || cap=$vp_page
    page_start=$view_from
    view_from=$(( page_start + cap ))
    (( cursor >= page_start && cursor < view_from )) || cursor=$page_start
    draw_list_block
}

# The rows from page_start to view_from, and the footer under them.
draw_list_block() {
    local total=${#view[@]} cols needle=${view_filter,,}
    cols=$(term_cols)
    (( cols > 20 )) || cols=20
    # Fixed cells: cursor mark (2), number, a space, the label, a space, the date
    # (17), a space. The label gives way before the date does, and the path takes
    # whatever is left, or is dropped when that is too little to be worth reading.
    local whenw=17 lw=$(( vp_namew - 2 ))
    local fixed=$(( 2 + vp_numw + 1 + 1 + whenw + 1 ))
    (( lw > cols - fixed - 1 )) && lw=$(( cols - fixed - 1 ))
    (( lw < 8 )) && lw=8
    local pathw=$(( cols - 1 - fixed - lw ))

    local any_today=0 k n label path base mark prev=-1 home=$HOME
    if (( view_chrono && total )); then
        entry_ts "${view[0]}"; when_label "$ets"; any_today=$when_today
    fi
    lb_rows=0
    for (( k = page_start; k < view_from; k++ )); do
        n=${view[k]}
        entry_ts "$n"; when_label "$ets"
        if (( view_chrono && any_today && when_today != prev )); then
            if (( when_today )); then
                print_header 92 "TODAY" "$cols" > /dev/tty
            else
                print_header 90 "EARLIER" "$cols" > /dev/tty
            fi
            (( lb_rows++ ))
        fi
        prev=$when_today

        label=${sel_names[n]}
        local ln=$needle
        if (( ${#label} > lw )); then label="${label:0:lw-1}…"; ln=''; fi
        mark='  '; base=$'\e[01;34m'
        if (( k == cursor )); then mark="${C_KEY}▶${C_OFF} "; base=$'\e[01;7;34m'; fi

        printf '%s\e[90m%*d\e[0m ' "$mark" "$vp_numw" "$n" > /dev/tty
        print_label "$label" "$ln" "$lw" "$base" > /dev/tty
        if (( when_today )); then
            printf " ${C_TODAY}%-*s${C_OFF} " "$whenw" "$when" > /dev/tty
        else
            printf " ${C_DIM}%-*s${C_OFF} " "$whenw" "$when" > /dev/tty
        fi
        path=${sel_paths[n]}
        [[ "$path" == "$home"/* ]] && path="~${path#"$home"}"
        if (( pathw >= 12 )); then
            (( ${#path} > pathw )) && path="…${path: -$(( pathw - 1 ))}"
            printf '\e[90m%s\e[0m' "$path" > /dev/tty
        fi
        printf '\e[K\n' > /dev/tty
        (( lb_rows++ ))
    done

    local first=$(( page_start + 1 )) last=$view_from scope='' nav=''
    [[ -n "$view_filter" ]] && scope="${C_HINT} matching ${C_NOW}\"$view_filter\""
    [[ -n "$list_filter" && -z "$view_filter" ]] && scope="${C_HINT} matching ${C_NOW}\"$list_filter\""
    [[ -n "$view_since_label" ]] && scope+="${C_HINT} touched ${C_NOW}$view_since_label"
    if (( view_from < total )); then
        printf -v nav "${C_DIM} · ${C_KEY}n${C_HINT} next %d" \
            "$(( total - view_from < vp_page || vp_page == 0 ? total - view_from : vp_page ))"
    fi
    (( page_start > 0 )) && nav+="${C_DIM} · ${C_KEY}p${C_HINT} back"
    local foot
    printf -v foot "${C_DIM}… ${C_NOW}%d-%d${C_HINT} of ${C_NOW}%d%s%s${C_OFF}" \
        "$first" "$last" "$total" "$scope" "$nav"
    printf '%s\e[K\n' "$foot" > /dev/tty
    count_vis_rows "$foot" "$cols"
    lb_rows=$(( lb_rows + vis_rows ))
}

# The prompt under a cursor list. Its row count is kept for the redraw.
lp_prompt_rows=1
list_prompt() {
    local p
    printf -v p "${C_DIM}→ ${C_KEY}↑↓${C_HINT} move ${C_DIM}· ${C_KEY}enter${C_HINT} opens ${C_KEY}▶${C_DIM} · ${C_HINT}number, or text to search again ${C_DIM}· ${C_KEY}/${C_HINT} clears ${C_DIM}· ${C_KEY}?${C_HINT} help ${C_DIM}· ${C_KEY}esc${C_HINT} stays${C_DIM}: ${C_OFF}"
    printf '%s\e[K' "$p" > /dev/tty
    count_vis_rows "$p" "$(term_cols)"
    lp_prompt_rows=$vis_rows
}

# Move the cursor by $1 within the view. Inside the page: redraw it in place.
# Off either end of the page: print the next or previous page below, the cursor
# on its nearest row, the way n and p would.
list_move() {
    local to=$(( cursor + $1 )) total=${#view[@]}
    (( to >= 0 && to < total )) || return 0
    if (( to >= page_start && to < view_from )); then
        cursor=$to
        if (( lb_rows + lp_prompt_rows <= $(term_rows) )); then
            printf '\r\e[%dA' "$(( lb_rows + lp_prompt_rows - 1 ))" > /dev/tty
        else
            printf '\r\e[K' > /dev/tty
        fi
        draw_list_block
        return 0
    fi
    printf '\r\e[K' > /dev/tty
    if (( to >= view_from )); then
        cursor=$to
        render_list_page
    else
        local back=$vp_page
        (( back > 0 )) || back=$page_start
        view_from=$(( page_start - back ))
        (( view_from < 0 )) && view_from=0
        render_list_page
        cursor=$to
        printf '\r\e[%dA' "$(( lb_rows ))" > /dev/tty
        draw_list_block
    fi
}

# Read one answer at a cursor list into `reply`, in the same language as the
# line prompt: enter becomes the number under the cursor, ctrl-d and Esc become
# q, and any other key starts an ordinary line — prefilled with that key — so a
# number, a new search, n, s or c all still work.
read_list_reply() {
    local c seq
    while :; do
        list_prompt
        IFS= read -rsn1 c < /dev/tty || { printf '\n' > /dev/tty; reply=q; return 0; }
        case "$c" in
            '')
                printf '\n' > /dev/tty; reply=${view[cursor]}; return 0 ;;
            $'\e')
                seq=''
                IFS= read -rsn2 -t 0.05 seq < /dev/tty
                case "$seq" in
                    '[A'|'OA') list_move -1 ;;
                    '[B'|'OB') list_move 1 ;;
                    '') printf '\n' > /dev/tty; reply=q; return 0 ;;
                    *)  # Another sequence (PgUp, F-keys): swallow its tail.
                        IFS= read -rsn8 -t 0.02 seq < /dev/tty ;;
                esac ;;
            $'\x10') list_move -1 ;;   # ctrl-p
            $'\x0e') list_move 1 ;;    # ctrl-n
            $'\x04') printf '\n' > /dev/tty; reply=q; return 0 ;;
            $'\x7f'|$'\b'|$'\t') ;;
            *)
                IFS= read -e -r -i "$c" reply < /dev/tty || { printf '\n' > /dev/tty; reply=q; }
                return 0 ;;
        esac
        printf '\r' > /dev/tty
    done
}

# One line of help: what you type, then what it does. Two colours, never one —
# the key is the only part of the line that is an instruction, and in a single
# colour it disappears into the sentence explaining it.
help_row() {
    printf "  ${C_KEY}%-10s${C_HINT}%s${C_OFF}\n" "$1" "$2" > /dev/tty
}

# A sort row, with the one in force marked in C_NOW rather than described as
# "(now: …)" somewhere else on the line. The marker is on the row it belongs to,
# so the current order is found by looking rather than by reading.
help_sort_row() {
    local key=$1 mode=$2 now=''
    [[ "$sort_mode" == "$mode" ]] && now="${C_NOW}  ← now${C_OFF}"
    printf "  ${C_KEY}%-10s${C_HINT}sort by %s ${C_DIM}— %s${C_OFF}%s\n" \
        "$key" "$(sort_label "$mode")" "$(sort_desc "$mode")" "$now" > /dev/tty
}

browse_help() {
    help_row '23'   'cd into entry 23 — numbers are the ranking, not the page'
    help_row 'text' 'search labels and paths for "text" (case-insensitive), newest first'
    help_row '↑ ↓'  'in a search: move the cursor (ctrl-p / ctrl-n too); enter opens it'
    help_row '/'    'clear the search (and any timeframe), back to the full ranking'
    help_row '@3d text' 'search only what was touched in a timeframe: @today, @yesterday, @week, @month, @3d, @2w'
    help_row '@'    'drop the timeframe, keep the search'
    help_row 'n  +' 'next page'
    help_row 'p  -' 'previous page'
    help_row 't'    'back to the top of this view'
    help_row 'a'    'everything in this view, unpaged'
    help_row 's'    "cycle the order: recency → frecency → visits → name"
    help_sort_row 'sr' time
    help_sort_row 'sf' frecency
    help_sort_row 'sv' activity
    help_sort_row 'sn' name
    help_row 'ss'   'keep the order in force — every listing starts in it from now on'
    help_row 'c'    'settings menu (also /config) — change a setting, saved, listing redrawn'
    help_row '?'    'this'
    if (( focus_n )); then
        help_row 'enter' 'more of today, while there is more — then stay put'
        help_row 'q'     'stay put (ctrl-d too)'
    else
        help_row 'enter q' 'stay put (ctrl-d too)'
    fi
}

# Keep the order in force, for every listing from now on. This is the place the
# question gets answered: you find out which order you actually want by pressing
# `s` until the screen looks right, and being told at that moment to quit and run
# a second command from memory is how a preference stays unset for a year. The
# label the prompt has been showing all along is also a legal value of the
# setting, so what is written is literally what the screen says.
save_sort() {
    local label; label=$(sort_label)
    write_setting sort "$label"
    printf "${C_HINT}kept: every listing now starts in ${C_NOW}%s${C_HINT} order ${C_DIM}· %s${C_OFF}\n" \
        "$label" "$settings_file" > /dev/tty
    warn_env_wins sort > /dev/tty
}

# Re-print the listing in the current sort_mode. Re-print rather than re-order in
# place: a listing's numbers are its own — 23 means the 23rd of *this* ranking —
# so changing the order has to produce a new listing, above the prompt, the way
# running the command again would. Cheap, too: the buckets are already built, so
# nothing is stat'd or read a second time.
resort() {
    printf "${C_DIM}within each group: ${C_NOW}%s${C_DIM} — %s, renumbered ${C_DIM}· ${C_KEY}ss${C_HINT} keeps it${C_OFF}\n" \
        "$(sort_label)" "$(sort_desc)" > /dev/tty
    render_listing
    build_view
    # An unfiltered view continues below the screenful just printed, as it does on
    # entry; a filtered one has its own first result and nothing above the prompt
    # to continue from.
    if [[ -n "$view_filter$view_since_label" ]]; then render_page; else view_from=$sel_shown; fi
}

# A page of a busy day's TODAY: laid out over today's labels alone and stopping at
# its last entry, so "more of today" is exactly that.
render_today_page() {
    plan_view_layout "$focus_n"
    page_stop=$focus_n
    render_page
    page_stop=0
    plan_view_layout
}

# The first page of the view. On a busy day, with nothing narrowing it, that is
# the first page of today, so clearing a search lands back where the listing
# started rather than on a page laid out for all seven hundred.
render_top() {
    if (( focus_n && view_since == 0 )) && [[ -z "$view_filter" ]]; then
        render_today_page
    else
        render_page
    fi
}

# Whether enter means "more of today" right now: a busy-day listing, nothing
# narrowing the view, and some of TODAY not yet printed. Everywhere else enter
# keeps its old meaning, stay put, and the prompt line says which it is.
enter_pages() {
    (( focus_n > 0 && view_since == 0 && view_from < focus_n )) && [[ -z "$view_filter" ]]
}

# The settings menu from inside a listing, then the listing again in whatever
# was chosen — the redraw is the point: tinkering means seeing the effect.
settings_redraw() {
    local old_sort=${LSRECENT_SORT:-}
    menu_changed=0
    settings_menu
    (( menu_changed )) || return 0
    if [[ "${LSRECENT_SORT:-}" != "$old_sort" ]]; then
        case "${LSRECENT_SORT:-}" in
            frecency)        sort_mode=frecency ;;
            visits|activity) sort_mode=activity ;;
            name)            sort_mode=name ;;
            *)               sort_mode=time ;;
        esac
    fi
    listing_settings
    bucket_repos "$lr_root" "$lr_full"
    printf "${C_DIM}— redrawn with the new settings, renumbered${C_OFF}\n" > /dev/tty
    render_listing
    view_filter=''; view_since=0; view_since_label=''
    build_view
    view_from=$sel_shown
}

# The line prompt under the listing itself, into `reply`. Fails on EOF.
read_line_reply() {
    # Every key on this line is in C_KEY and nothing else is, so the line reads
    # as a row of buttons with labels rather than as a sentence to be parsed.
    # The order in force is named here too — it is the one piece of state the
    # listing above cannot show, and it decides what the numbers mean.
    local enter="${C_KEY}enter${C_HINT} stays"
    enter_pages && enter="${C_KEY}enter${C_HINT} more of today ${C_DIM}· ${C_KEY}q${C_HINT} stays"
    printf "${C_DIM}→ ${C_HINT}number ${C_DIM}· ${C_HINT}text to search ${C_DIM}· ${C_KEY}n${C_DIM}/${C_KEY}p${C_HINT} pages ${C_DIM}· ${C_KEY}s${C_HINT} sort ${C_DIM}(${C_NOW}%s${C_DIM}) · ${C_KEY}c${C_HINT} settings ${C_DIM}· ${C_KEY}?${C_HINT} help ${C_DIM}· %s${C_DIM}: ${C_OFF}" \
        "$(sort_label)" "$enter" > /dev/tty
    # A bare `read` with no reply (EOF from ctrl-d) leaves the cursor mid-line.
    IFS= read -r reply < /dev/tty || { printf '\n' > /dev/tty; return 1; }
}

browse() {
    local dest=$1 reply d
    build_view
    # The first screenful is already above the prompt — cmd_repos printed it — so
    # `+` continues the ranking rather than repeating its opening. Only the
    # unfiltered view inherits this; a search starts from its own first result.
    view_from=$sel_shown
    # A search from the command line printed nothing yet: its answer is the cursor
    # list, drawn here.
    if (( lr_list_quiet )); then view_from=0; render_page; fi

    while :; do
        if view_narrowed && (( ${#view[@]} )); then
            read_list_reply
        else
            read_line_reply || return 0
        fi

        case "$reply" in
            '')
                # Enter is "stay put", except where the screen has just said it is
                # not: one match left standing by a search is an answer, not a
                # list. `q` and ctrl-d stay put unconditionally, so there is always
                # a way out that does not move you.
                if [[ -n "$view_filter$view_since_label" ]] && (( ${#view[@]} == 1 )); then
                    reply=${view[0]}
                elif enter_pages; then
                    render_today_page
                    continue
                else
                    return 0
                fi ;;
            q|Q)
                return 0 ;;
            '?')
                browse_help; continue ;;
            '+'|n|N|next|more)
                if (( view_from >= ${#view[@]} )); then
                    printf "${C_HINT}that is the end of the list ${C_DIM}— ${C_KEY}p${C_HINT} goes back${C_OFF}\n" > /dev/tty
                else
                    render_page
                fi
                continue ;;
            '-'|p|P|prev|back)
                # A real previous page, printed again below rather than scrolled
                # to. Re-printing rows is not the confusion it would be in a pager:
                # a number *is* the ranking, so an entry that appears twice is the
                # same repository with the same number both times, and this tool
                # never clears the screen — walking back down the list has to leave
                # the same trail in the scrollback that walking up it did.
                if (( page_start == 0 )); then
                    printf "${C_HINT}that is the top ${C_DIM}— ${C_HINT}the first page is just above${C_OFF}\n" > /dev/tty
                else
                    # Inside a busy day's TODAY, the page before is a page of today,
                    # sized the way enter sized the one you are leaving.
                    local in_today=0
                    (( focus_n && view_since == 0 && page_start <= focus_n )) \
                        && [[ -z "$view_filter" ]] && in_today=1
                    (( in_today )) && plan_view_layout "$focus_n"
                    local back=$vp_page
                    (( back > 0 )) || back=$page_start
                    view_from=$(( page_start - back ))
                    (( view_from < 0 )) && view_from=0
                    if (( in_today )); then
                        plan_view_layout
                        render_today_page
                    else
                        render_page
                    fi
                fi
                continue ;;
            t|T|top)
                view_from=0; render_top; continue ;;
            a|A|all)
                view_from=0; render_page unlimited; continue ;;
            s|S|sort)
                # The cycle starts from the default and walks away from it, so one
                # press of `s` is always "not recency" and the third press is home
                # again.
                case "$sort_mode" in
                    time)     sort_mode=frecency ;;
                    frecency) sort_mode=activity ;;
                    activity) sort_mode=name ;;
                    *)        sort_mode=time ;;
                esac
                resort; continue ;;
            # Direct selection as well as the cycle. Cycling is fine with three
            # orders and one of them wanted; it is a guessing game when the one you
            # want is two presses away and you have to read the screen between them
            # to find out. `s` plus the order's initial goes straight there, and
            # says nothing when you were already in it.
            sr|SR|recency|recent)
                sort_mode=time;     resort; continue ;;
            sv|SV|sa|SA|visits|busiest)
                sort_mode=activity; resort; continue ;;
            sf|SF|frecency)
                sort_mode=frecency; resort; continue ;;
            sn|SN|alpha)
                sort_mode=name;     resort; continue ;;
            ss|SS|save|keep)
                save_sort; continue ;;
            c|C|/c|/config|/settings|/set)
                settings_redraw; continue ;;
            /)
                view_filter=''; view_since=0; view_since_label=''
                build_view; render_top; continue ;;
            @)
                view_since=0; view_since_label=''
                build_view; render_top; continue ;;
            @*)
                # `@today`, `@3d`, `@2w claude`: a timeframe, then optionally a
                # search inside it. A timeframe it cannot read is said rather
                # than searched for — "@tdoay" is a typo, not a repo name.
                local spec=${reply#@} text=''
                if [[ "$spec" == *' '* ]]; then
                    text=${spec#* }; spec=${spec%% *}
                    text=${text#"${text%%[![:space:]]*}"}
                fi
                if ! parse_since "$spec"; then
                    printf "${C_HINT}not a timeframe: ${C_NOW}%s${C_DIM} — ${C_KEY}@today${C_DIM}, ${C_KEY}@yesterday${C_DIM}, ${C_KEY}@week${C_DIM}, ${C_KEY}@3d${C_DIM}, ${C_KEY}@2w${C_DIM}, ${C_HINT}then optional text${C_OFF}\n" \
                        "$spec" > /dev/tty
                    continue
                fi
                view_since=$since_lo; view_since_label=$since_label
                view_filter=$text
                build_view; render_page; continue ;;
        esac

        # A leading slash is accepted but not required. Bare text is the more
        # forgiving default: anyone who types a repository name at a prompt that
        # invites one means to search for it, and no valid selection is anything
        # other than digits.
        if [[ "$reply" == /* ]]; then
            view_filter=${reply#/}
            build_view
            render_page
            continue
        fi

        if [[ ! "$reply" =~ ^[0-9]+$ ]]; then
            view_filter=$reply
            build_view
            render_page
            continue
        fi

        if [[ -z ${sel_paths[10#$reply]:-} ]]; then
            printf "${C_HINT}no entry ${C_NOW}%s${C_DIM} — ${C_HINT}1-${C_NOW}%d${C_HINT}, or text to search${C_OFF}\n" \
                "$reply" "$sel_n" > /dev/tty
            continue
        fi
        d=${sel_paths[10#$reply]}
        if [[ ! -d "$d" ]]; then
            printf "${C_HINT}gone since the listing: %s${C_OFF}\n" "$d" > /dev/tty
            continue
        fi
        # Echoed so the destination survives in the scrollback: the prompt line
        # that follows shows the new directory, but this says which number it was.
        printf "${C_HINT}%s${C_OFF}\n" "$d" > /dev/tty
        printf '%s\n' "$d" > "$dest" 2>/dev/null
        return 0
    done
}

# Resolve a number from the last listing to its path.
cmd_path() {
    local want=$1
    [[ "$want" =~ ^[0-9]+$ ]] || die "not a number: $want"
    [[ -f "$sel_map" ]] || die "no listing recorded yet — run ls, lsrepos or lstoday first"
    local n p
    while IFS=$'\t' read -r n p; do
        [[ "$n" == "$want" ]] || continue
        [[ -d "$p" ]] || die "gone since the listing: $p"
        printf '%s\n' "$p"
        return 0
    done < "$sel_map"
    die "no entry $want in the last listing"
}

# ---------------------------------------------------------------------------
# Grouped listing — directory level (original behaviour)
# ---------------------------------------------------------------------------

cmd_show() {
    local target="" passthru=()
    while (( $# )); do
        case "$1" in
            # Only meaningful when this delegates to cmd_repos below; a directory
            # listed as its own children is laid out by `ls`, which has its own.
            --all|-a|--time|--recency|-t|--name|-n|--activity|--visits|-A|--frecency|-f|--since=*|--within=*)
                      passthru+=("$1") ;;
            --since|--within)
                      passthru+=("$1" "${2:-}"); shift ;;
            -*)       die "unknown option: $1" ;;
            *)        target=$1 ;;
        esac
        shift
    done
    [[ -n "$target" ]] || target="."
    # `lsr wms` — a bare word that is not a directory here is a repository search,
    # handed to the repo view against the default root. It is the shortest thing
    # to type, so it should be the thing that works; `lsr ./wms` still means the
    # directory. Same rule as cmd_repos, which owns the search itself.
    if [[ ! -d "$target" && "$target" != */* && "$target" != . && "$target" != .. ]]; then
        cmd_repos "${passthru[@]}" "$target"
        return
    fi
    [[ -d "$target" ]] || die "not a directory: $target"

    # A directory that only groups repositories is more useful listed as
    # repositories than as children: its subfolders are organisational (a topic
    # is never the thing being opened) and any loose notes beside them are noise.
    # A directory that is itself a repo keeps the child listing — there the files
    # and folders *are* the content.
    if [[ ! -e "$target/.git" ]] && has_nested_repo "$target"; then
        local abs; abs=$(resolve "$target") || die "no such directory: $target"
        cmd_repos "${passthru[@]}" "$abs"
        return
    fi

    local cols; cols=$(term_cols)
    local now midnight
    now=$(now_epoch)
    midnight=$(midnight_epoch)

    local g_today=() g_week=() g_month=() g_quarter=() g_older=()
    local name mtime age_days

    # One `find` for the whole directory rather than a `stat` per entry: at 30
    # entries that is 194ms against 8ms, and unlike a batched `stat "$dir"/*`
    # it has no argument-list ceiling. NUL-delimited so newlines in names are
    # safe; `! -name '.*'` preserves the glob's behaviour of skipping dotfiles.
    while IFS='|' read -r -d '' mtime name; do
        [[ -n "$name" ]] || continue
        mtime=${mtime%.*}
        if (( mtime >= midnight )); then
            g_today+=("$name")
            continue
        fi
        age_days=$(( (now - mtime) / 86400 ))
        if   (( age_days <= 7 ));  then g_week+=("$name")
        elif (( age_days <= 30 )); then g_month+=("$name")
        elif (( age_days <= 90 )); then g_quarter+=("$name")
        else                            g_older+=("$name")
        fi
    done < <(find "$target" -mindepth 1 -maxdepth 1 ! -name '.*' \
                  -printf '%T@|%f\0' 2>/dev/null)

    # Bucket contents are ordered by `ls -t` at print time, so the order find
    # happened to yield does not matter here.

    local shown=0

    show_group() {
        local color=$1 label=$2
        shift 2
        (( $# == 0 )) && return
        (( shown )) && echo
        shown=1
        print_header "$color" "$label" "$cols"
        ( cd "$target" && command ls -dtC -w "$cols" --color=always -- "$@" )
    }

    show_group 92 "TODAY"          "${g_today[@]}"
    show_group 96 "PAST WEEK"      "${g_week[@]}"
    show_group 93 "PAST MONTH"     "${g_month[@]}"
    show_group 95 "PAST 3 MONTHS"  "${g_quarter[@]}"
    show_group 90 "OLDER"          "${g_older[@]}"

    (( shown )) || echo "(empty)"
}

# ---------------------------------------------------------------------------
# Grouped listing — repository level
# ---------------------------------------------------------------------------

# Buckets, and the listing state the browser needs to print the listing again in
# a different order. Global rather than local to cmd_repos because `s` at the
# prompt re-renders, and re-rendering has to start from the buckets as they were
# built — newest-first — not from whatever order the last render left them in.
declare -a g_today=() g_yest=() g_d2=() g_d3=() g_d4=() g_d5=() g_d6=() g_d7=() \
           g_month=() g_quarter=() g_older=() g_undated=()

declare -a group_labels=("TODAY" "YESTERDAY" \
                         "2 DAYS AGO" "3 DAYS AGO" "4 DAYS AGO" \
                         "5 DAYS AGO" "6 DAYS AGO" "7 DAYS AGO" \
                         "PAST MONTH" "PAST 3 MONTHS" "OLDER" "UNDATED")
# The six numbered-day buckets deliberately share one colour. The header colour
# says how recent, coarsely — green is now, grey is history — and all six are
# "this week"; the label is what distinguishes them, and six shades of cyan would
# only invite reading a precision into the colour that is not there. UNDATED is
# grey with OLDER because it is the same kind of answer: not what you want.
declare -a group_colors=(92 32 96 96 96 96 96 96 93 95 90 90)
declare -a group_vars=(g_today g_yest g_d2 g_d3 g_d4 g_d5 g_d6 g_d7 \
                       g_month g_quarter g_older g_undated)
# Where each bucket's activity count starts. A day bucket counts visits inside
# that day, which is what makes "busiest" mean the same thing in every row of the
# listing; the coarse buckets have no single day to count, so they count the whole
# log and rank by how often you go back to the thing at all.
declare -a group_cutoff=()

# Order within a bucket: time, activity or name.
#
# `time` is the default, and was `name` until 1.12.0. The argument for name was
# that the bucket already holds the recency, so within it the useful order is the
# one you can scan for a name you already have in mind. That holds for the coarse
# buckets — PAST MONTH is not a chronology anybody remembers — but not for TODAY,
# which is the bucket the listing exists for and is read top-down: the last thing
# you opened should be the first thing on the screen, because it is nearly always
# the thing you meant to go back to. Alphabetical inside today's work puts it
# wherever its initial falls.
sort_mode=time

lr_root=""
lr_cols=80
lr_no_limit=0
lr_pretty=1
lr_search_order=newest
lr_list_quiet=0
lr_full=0

# Busy-day focus. When TODAY holds at least focus_min repos (the focus_today
# setting, default 10), the first screen is today and nothing else: on a day you
# have been in forty repositories the question is "which of today's", and
# YESTERDAY onwards is a page of answers to a different question pushing it off
# the screen. focus_n is how many TODAY holds once the listing has decided to
# focus, 0 when it has not. Nothing is renumbered — the older repos are numbered
# after today's as always, `n` pages into them and `23` still reaches them — and
# enter at the prompt shows the next page of *today* rather than staying put.
focus_min=0
focus_n=0

# A search term given on the command line — `lsrepos wms` — held lowercased,
# because match_tier expects the needle that way and this one is compared against
# every repo in the tree.
list_filter=''

# Fill the buckets from repo_ts, newest-first within each. Entries are
# "display<TAB>abspath": the display name drops the topic folder unless --full,
# but the number has to resolve to a real path, and sorted_repos yields paths
# relative to root.
bucket_repos() {
    local root=$1 full=$2
    g_today=(); g_yest=(); g_d2=(); g_d3=(); g_d4=(); g_d5=(); g_d6=(); g_d7=()
    g_month=(); g_quarter=(); g_older=(); g_undated=()

    local now midnight
    now=$(now_epoch)
    midnight=$(midnight_epoch)
    day_midnights "$midnight"
    group_cutoff=("${day_mid[@]}" 0 0 0 0)

    local ts rel name entry age_days
    local opened_only=0; [[ -n "$window" ]] && opened_only=1
    while IFS=$'\t' read -r ts rel; do
        [[ -n "$rel" ]] || continue
        in_window "$ts" || continue
        (( since_lo == 0 || ts >= since_lo )) || continue
        if (( full )); then name=$rel; else name=${rel##*/}; fi
        # Repo-names-like-this read as repo names like this. Display only: the
        # entry still carries the real path, and searching folds hyphens,
        # underscores and spaces together, so either spelling finds it.
        (( lr_pretty )) && name=${name//[-_]/ }
        # A search given on the command line reduces the set *before* bucketing, so
        # what prints is an ordinary grouped listing that happens to contain only
        # matches — numbered from 1, under the same headers, answered by the same
        # prompt. Filtering in the browser instead would mean numbering 315 repos
        # in order to show four of them.
        [[ -z "$list_filter" ]] || match_tier "$name" "$root/$rel" "$list_filter" || continue
        entry="$name"$'\t'"$root/$rel"
        # The last week gets one bucket per calendar day rather than a single PAST
        # WEEK. "Today or yesterday?" was always the question being asked, and it
        # does not stop being the question at 48 hours: "Tuesday" and "six days
        # ago" are different answers, and a week of repos in one heap is exactly
        # the undifferentiated pile the buckets exist to break up. A repo has one
        # newest timestamp, so it lands in exactly one bucket. With a window set
        # every entry falls in a single bucket anyway, and the group loop below
        # prints just that one.
        if   (( ts == 0 ));          then g_undated+=("$entry")
        elif (( ts >= day_mid[0] )); then g_today+=("$entry")
        elif (( ts >= day_mid[1] )); then g_yest+=("$entry")
        elif (( ts >= day_mid[2] )); then g_d2+=("$entry")
        elif (( ts >= day_mid[3] )); then g_d3+=("$entry")
        elif (( ts >= day_mid[4] )); then g_d4+=("$entry")
        elif (( ts >= day_mid[5] )); then g_d5+=("$entry")
        elif (( ts >= day_mid[6] )); then g_d6+=("$entry")
        elif (( ts >= day_mid[7] )); then g_d7+=("$entry")
        else
            # Below day_mid[7] everything is at least seven days old, so the coarse
            # buckets here cannot overlap the calendar days above however late in
            # the day `now` is.
            age_days=$(( (now - ts) / 86400 ))
            if   (( age_days <= 30 )); then g_month+=("$entry")
            elif (( age_days <= 90 )); then g_quarter+=("$entry")
            else                            g_older+=("$entry")
            fi
        fi
    done < <(sorted_repos "$root" "$opened_only")
    return 0
}

# How many times the visit log recorded this repo being opened since $1. Sets
# `activity` rather than echoing it: this is called once per entry, and a command
# substitution there is a fork per repo.
activity=0
activity_since() {
    local cutoff=$1 path=$2 t
    activity=0
    for t in ${visit_times[$path]:-}; do
        (( t >= cutoff )) && (( activity++ ))
    done
    return 0
}

# The whole listing in display order: every bucket's entries, ordered within the
# bucket by sort_mode, laid end to end, with each bucket's slice recorded rather
# than copied into an array of its own. The buckets themselves are left alone, so
# `s` can re-order from the original newest-first order however many times it is
# pressed.
declare -a ord_entries=()
declare -a ord_start=()
declare -a ord_count=()

# One `sort` for the listing rather than one per bucket. Nine forks on a normal
# listing is the difference between this being free and this being felt: it runs
# on every bare `ls` in a repo-grouping directory, and now on every press of `s`
# as well. The bucket index leads the sort key, so a single pass cannot mix two
# buckets together however the rest of the key compares.
#
# The stream is "bucket, score, position, label, path" and the sort key picks from
# it: bucket always leads, then
#   name      the display label, case-folded
#   visits    score descending, then the label
#   frecency  score descending, then position — where position is the entry's
#             index in the bucket as built, which is newest-first, so this is
#             "busiest, most recent breaking the ties"
# The label, never the whole line — the path after it would otherwise decide ties
# by topic folder, so two repos with the same name would sort apart from where
# their names put them. (Under --full the label *is* topic/repo and sorts by topic
# anyway.) Ties falling to the name is what makes the busiest-first view of a
# bucket nobody visited identical to the alphabetical one, rather than an
# arbitrary order that changes between listings — and it is exactly that property
# frecency gives up on purpose: a bucket nobody visited is all zeroes, so under
# frecency it stays in recency order rather than collapsing to the alphabet.
order_listing() {
    ord_entries=(); ord_start=(); ord_count=()
    local i ref e n=0

    if [[ "$sort_mode" == time ]]; then
        # Already newest-first, which is the order the buckets were built in.
        for i in "${!group_vars[@]}"; do
            ref="${group_vars[$i]}[@]"
            local -a grp=("${!ref}")
            ord_start[$i]=$n
            ord_count[$i]=${#grp[@]}
            (( ${#grp[@]} )) && ord_entries+=("${grp[@]}")
            n=$(( n + ${#grp[@]} ))
        done
        return 0
    fi

    local -a key=()
    case "$sort_mode" in
        activity) key=( -k1,1n -k2,2nr -k4,4f ) ;;
        frecency) key=( -k1,1n -k2,2nr -k3,3n ) ;;
        *)        key=( -k1,1n -k4,4f ) ;;
    esac

    local -a flat=()
    mapfile -t flat < <(
        for i in "${!group_vars[@]}"; do
            ref="${group_vars[$i]}[@]"
            local pos=0
            for e in "${!ref}"; do
                if [[ "$sort_mode" == name ]]; then
                    activity=0
                else
                    activity_since "${group_cutoff[$i]}" "${e#*$'\t'}"
                fi
                printf '%s\t%s\t%s\t%s\n' "$i" "$activity" "$(( pos++ ))" "$e"
            done
        done | sort -t$'\t' "${key[@]}"
    )

    # Back into slices. The stream is already grouped by bucket, so this is one
    # walk: a change of bucket index closes the previous slice.
    for i in "${!group_vars[@]}"; do
        ord_start[$i]=0
        ord_count[$i]=0
    done
    for e in "${flat[@]}"; do
        i=${e%%$'\t'*}
        (( ord_count[$i] )) || ord_start[$i]=$n
        (( ord_count[$i]++ ))
        e=${e#*$'\t'}                  # bucket index
        e=${e#*$'\t'}                  # score
        ord_entries+=("${e#*$'\t'}")   # position
        (( n++ ))
    done
    return 0
}

# Two names per order, and both are needed. The short one is a word the prompt
# can carry on every line without crowding it — it answers "which order am I in"
# — and the long one is the sentence the help gives once, next to the key that
# selects it.
sort_label() {
    case "${1:-$sort_mode}" in
        time)     echo "recency" ;;
        activity) echo "visits" ;;
        frecency) echo "frecency" ;;
        *)        echo "name" ;;
    esac
}

sort_desc() {
    case "${1:-$sort_mode}" in
        time)     echo "most recently opened first" ;;
        activity) echo "busiest first, inside the bucket's own day" ;;
        frecency) echo "busiest first, most recent breaking the ties" ;;
        *)        echo "alphabetical" ;;
    esac
}

# Print the listing. Everything above this is what the listing is *of*; this is
# the part that runs again when the order changes, so it owns all the numbering
# state and resets it on entry.
render_listing() {
    local cols=$lr_cols
    sel_paths=(); sel_names=(); sel_n=0; sel_total=0; sel_shown=0

    order_listing
    sel_total=${#ord_entries[@]}

    local budget=0
    (( lr_no_limit )) || budget=$(row_budget)

    focus_n=0
    (( focus_min > 0 && ord_count[0] >= focus_min )) && focus_n=${ord_count[0]}

    # Print oldest-group-last, stopping when the screen is full. The groups run
    # newest-first, so cutting from the end drops the least interesting buckets
    # whole, and a truncated listing is still the right answer to "what was I
    # working on recently?". Only the bucket at the fold is cut part-way, and
    # there the cut falls where the within-group order puts it. That is survivable
    # because everything cut is still numbered and the prompt can search or page
    # to it; before that was true this had to cut by age.
    local shown=0 used=0 hidden=0 i count overhead rows_needed avail take
    for i in "${!group_vars[@]}"; do
        count=${ord_count[$i]}
        (( count )) || continue
        local -a grp=("${ord_entries[@]:${ord_start[$i]}:count}")

        # Once anything has been cut, the rest is only counted for the footer:
        # showing a later group after eliding an earlier one would misrepresent
        # the recency order the whole listing is built on.
        if (( hidden || (focus_n && i > 0) )); then
            hidden=$(( hidden + count ))
            register_hidden "${grp[@]}"
            continue
        fi

        plan_columns "$cols" "${grp[@]}"
        rows_needed=$(( (count + pn_per - 1) / pn_per ))
        overhead=1
        (( shown )) && overhead=2   # blank separator line, then the header

        take=$count
        if (( budget > 0 )); then
            avail=$(( budget - used - overhead ))
            # The newest group always gets its header and at least one row: a
            # budget too small to fit anything must not make a non-empty listing
            # fall through to the "nothing here" message.
            (( shown == 0 && avail < 1 )) && avail=1
            if (( avail < 1 )); then
                hidden=$(( hidden + count ))
                register_hidden "${grp[@]}"
                continue
            fi
            if (( rows_needed > avail )); then
                rows_needed=$avail
                take=$(( avail * pn_per ))
                (( take > count )) && take=$count
            fi
        fi

        (( shown )) && echo
        shown=1
        print_header "${group_colors[$i]}" "${group_labels[$i]}" "$cols"
        pack_numbered "${grp[@]:0:take}"
        sel_shown=$sel_n
        (( take < count )) && register_hidden "${grp[@]:take}"
        used=$(( used + overhead + rows_needed ))
        hidden=$(( hidden + count - take ))
    done

    (( shown )) || return 1

    if (( focus_n )); then
        local older=$(( sel_n - focus_n )) more=$(( focus_n - sel_shown ))
        if (( more > 0 )); then
            printf "${C_DIM}… ${C_HINT}a busy day, so today only: ${C_NOW}1-%d${C_HINT} of ${C_NOW}%d${C_DIM} · ${C_KEY}enter${C_HINT} for more of today${C_DIM} · ${C_HINT}%d older after them${C_DIM} · ${C_KEY}lsrepos --all${C_HINT} for everything${C_OFF}\n" \
                "$sel_shown" "$focus_n" "$older"
        else
            printf "${C_DIM}… ${C_HINT}a busy day, so today only: all ${C_NOW}%d${C_DIM} · ${C_NOW}%d${C_HINT} older, numbered ${C_NOW}%d-%d${C_DIM} · ${C_KEY}n${C_HINT} pages to them${C_DIM} · ${C_KEY}lsrepos --all${C_HINT} for everything${C_OFF}\n" \
                "$focus_n" "$older" "$(( focus_n + 1 ))" "$sel_n"
        fi
    elif (( hidden )); then
        local hint="lsrepos"
        case "$window" in
            today)     hint="lstoday" ;;
            yesterday) hint="lsyesterday" ;;
        esac
        # The elided repos are still numbered, so the footer names the range
        # rather than only offering --all: typing 23 works from here.
        printf "${C_DIM}… ${C_NOW}%d${C_HINT} more, numbered ${C_NOW}%d-%d${C_DIM} · ${C_KEY}n${C_HINT} pages to them, ${C_KEY}%s --all${C_HINT} prints them${C_OFF}\n" \
            "$hidden" "$(( sel_shown + 1 ))" "$sel_n" "$hint"
    fi
    noise_footer
    write_sel_map
    return 0
}

# Why UNDATED has anything in it. Printed every listing that suppressed a day,
# because a bucket of two hundred repositories with no explanation beside it is
# the same puzzle the bulk touch was — and the way out has to be on screen, not
# in the manual.
noise_footer() {
    (( noise_total )) || return 0
    # Named by the day that cost the most repos, not by whichever the hash
    # happened to yield first: the line offers a way to undo one day, so it has to
    # offer the one worth undoing, and it has to name the same day twice running.
    local day worst="" worst_n=0
    for day in "${!noise_suppressed[@]}"; do
        (( noise_suppressed[$day] > worst_n )) || continue
        worst=$day; worst_n=${noise_suppressed[$day]}
    done
    if (( ${#noise_suppressed[@]} > 1 )); then
        printf "${C_DIM}↯ ${C_NOW}%d${C_HINT} repos dated only by bulk touches on ${C_NOW}%d${C_HINT} days — UNDATED, not recent work ${C_DIM}· ${C_KEY}lsrecent noise${C_HINT} lists them${C_OFF}\n" \
            "$noise_total" "${#noise_suppressed[@]}"
    else
        printf "${C_DIM}↯ ${C_NOW}%d${C_HINT} repos dated only by a bulk touch on ${C_NOW}%s${C_HINT} — UNDATED, not recent work ${C_DIM}· ${C_KEY}lsrecent noise remove %s${C_HINT} trusts that day again${C_OFF}\n" \
            "$noise_total" "$worst" "$worst"
    fi
}

# A command-line search that leaves exactly one repository standing has already
# answered the question. Printing it, then asking which of the one you meant, is
# the retype-what-is-on-the-screen step this tool exists to remove — so the
# listing lands in the scrollback as usual and the shell is handed the path.
# Requires the cd file: without a shell function to act on it there is nothing to
# hand the path to, and the prompt's own notice about that is the better message.
jump_single() {
    [[ -n "$list_filter" ]] || return 1
    (( sel_n == 1 )) || return 1
    local dest=${LSRECENT_CD_FILE:-} d=${sel_paths[1]}
    [[ -n "$dest" && -d "$d" ]] || return 1
    printf "${C_DIM}→ ${C_HINT}the only match${C_DIM} · ${C_OFF}%s\n" "$d"
    printf '%s\n' "$d" > "$dest" 2>/dev/null
    return 0
}

# The settings a drawn listing depends on, read into the variables that drive it.
# Separate from cmd_repos so the browser can run it again after the settings
# menu, and redraw with what was just chosen.
listing_settings() {
    lr_search_order=${LSRECENT_SEARCH_ORDER:-newest}
    [[ "$lr_search_order" == newest || "$lr_search_order" == match ]] \
        || die "LSRECENT_SEARCH_ORDER must be newest or match: $lr_search_order"
    lr_pretty=${LSRECENT_PRETTY_NAMES:-1}
    [[ "$lr_pretty" == 0 || "$lr_pretty" == 1 ]] || die "LSRECENT_PRETTY_NAMES must be 0 or 1: $lr_pretty"
    # Focus only the plain listing. Anything that already narrowed it — a search,
    # a timeframe, --today, --all — has said what it wants to see.
    focus_min=${LSRECENT_FOCUS_TODAY:-10}
    [[ "$focus_min" =~ ^[0-9]+$ ]] || die "LSRECENT_FOCUS_TODAY must be a number: $focus_min"
    focus_min=$(( 10#$focus_min ))
    if (( lr_no_limit || since_lo )) || [[ -n "$window$list_filter" ]]; then focus_min=0; fi
}

cmd_repos() {
    local want_window="" full=0 root="" since_spec=""
    # Set before the loop, so an explicit flag on the command line still wins.
    case "${LSRECENT_SORT:-}" in
        time|recency|recent) sort_mode=time ;;
        activity|visits)     sort_mode=activity ;;
        frecency)            sort_mode=frecency ;;
        name)                sort_mode=name ;;
        '')                  sort_mode=time ;;
        *)                   die "LSRECENT_SORT must be recency, visits, frecency or name: $LSRECENT_SORT" ;;
    esac
    lr_no_limit=0
    while (( $# )); do
        case "$1" in
            --today)       want_window=today ;;
            --yesterday)   want_window=yesterday ;;
            --full)        full=1 ;;
            --all|-a)      lr_no_limit=1 ;;
            --time|--recency|-t)     sort_mode=time ;;
            --name|-n)               sort_mode=name ;;
            --activity|--visits|-A)  sort_mode=activity ;;
            --frecency|-f)           sort_mode=frecency ;;
            --since|--within)
                (( $# >= 2 )) || die "$1 needs a timeframe: today, yesterday, week, month, 3d, 2w ..."
                since_spec=$2
                [[ -n "$since_spec" ]] || die "$1 needs a timeframe: today, yesterday, week, month, 3d, 2w ..."
                shift ;;
            --since=*|--within=*)    since_spec=${1#*=} ;;
            -*)            die "unknown option: $1" ;;
            # A positional is a root if it is written like a path — it contains a
            # slash, or it is `.` / `..` — and a search term otherwise. Deciding by
            # `-d` instead would have made the meaning of `lsrepos smart-home`
            # depend on which directory you happened to be standing in, and would
            # have read a bare repo name as a root the moment one existed beside
            # you. Typing a name at a tool whose whole job is jumping to repos by
            # name means the name; `./x` is how you say you meant the directory.
            */*|.|..)      root=$1 ;;
            *)             list_filter=$(fold_needle "$1") ;;
        esac
        shift
    done
    set_window "$want_window"
    if [[ -n "$since_spec" ]]; then
        parse_since "$since_spec" \
            || die "not a timeframe: $since_spec (today, yesterday, week, month, 3d, 2w, 1m)"
    fi
    [[ -n "$root" ]] || root=$(default_root)
    root=$(resolve "$root") || die "no such directory: $root"
    [[ -d "$root" ]] || die "not a directory: $root"

    lr_full=$full
    listing_settings

    load_visits
    collect_repos "$root" || die "no git repositories under $root"

    lr_root=$root
    lr_cols=$(term_cols)
    bucket_repos "$root" "$full"

    # A search on the command line, answered at a terminal that will prompt: the
    # numbering is built as usual but not printed, and the browser draws the
    # matches as the cursor list instead — newest first, the first one under the
    # cursor, enter to go. Piped, or with no prompt to answer, it is the grouped
    # listing as before.
    lr_list_quiet=0
    if [[ -n "$list_filter" ]] && will_prompt; then
        if render_listing > /dev/null; then
            jump_single && return 0
            lr_list_quiet=1
            prompt_jump
            return 0
        fi
    elif render_listing; then
        jump_single || prompt_jump
        return 0
    fi

    if [[ -n "$list_filter" ]]; then
        printf "${C_HINT}no repository matches ${C_NOW}\"%s\"${C_HINT} under %s${C_OFF}\n" \
            "$list_filter" "$root"
        return 1
    fi
    if (( since_lo )); then
        printf "${C_HINT}No repos touched %s under %s${C_OFF}\n" "$since_label" "$root"
        return 1
    fi
    if [[ -n "$window" ]]; then
        printf "${C_HINT}No repos opened %s under %s${C_OFF}\n" "$window" "$root"
        [[ -s "$visit_log" ]] || printf "${C_HINT}The visit log is empty — it starts filling once the shell hook is loaded (open a new shell).${C_OFF}\n"
    else
        echo "(no repositories found under $root)"
    fi
}

# ---------------------------------------------------------------------------
# Picker
# ---------------------------------------------------------------------------

cmd_pick() {
    local want_window="" root=""
    while (( $# )); do
        case "$1" in
            --today)     want_window=today ;;
            --yesterday) want_window=yesterday ;;
            -*)          die "unknown option: $1" ;;
            *)           root=$1 ;;
        esac
        shift
    done
    set_window "$want_window"
    command -v fzf >/dev/null || die "pick requires fzf"
    [[ -n "$root" ]] || root=$(default_root)
    root=$(resolve "$root") || die "no such directory: $root"

    load_visits
    collect_repos "$root" || die "no git repositories under $root"

    local opened_only=0; [[ -n "$window" ]] && opened_only=1
    local names=() ts name
    while IFS=$'\t' read -r ts name; do
        in_window "$ts" || continue
        names+=("$name")
    done < <(sorted_repos "$root" "$opened_only")

    (( ${#names[@]} )) || die "nothing to pick"

    local prompt="repo> "
    [[ -n "$window" ]] && prompt="$window> "

    local preview='p='"$(printf '%q' "$root")"'/{}
        git -C "$p" -c color.ui=always log --oneline -8 2>/dev/null
        echo
        git -C "$p" -c color.ui=always status -sb 2>/dev/null | head -15'

    local sel
    sel=$(printf '%s\n' "${names[@]}" | fzf \
            --ansi --no-sort --height=60% --reverse \
            --prompt="$prompt" \
            --preview="$preview" \
            --preview-window=right,55%,border-left) || return 1

    [[ -n "$sel" ]] && printf '%s\n' "$root/$sel"
}

# ---------------------------------------------------------------------------
# Shell integration
# ---------------------------------------------------------------------------

# Put the eval into ~/.bashrc, idempotently. Lives here rather than in install.sh
# because the .deb has no install.sh to call: the package cannot do this itself
# (a root postinst has no business editing user dotfiles, and does not know which
# users want it), so the user runs this once per account.
#
# The search looks for the eval line itself in every file bash might source it
# from, not for our own marker comment — someone who added the line by hand has
# the integration installed, and a second eval is redundant clutter that has to
# be found and removed by hand later.
cmd_shell_install() {
    local f
    for f in ~/.bashrc ~/.bash_aliases ~/.bash_profile ~/.profile; do
        [[ -f "$f" ]] || continue
        if grep -q 'lsrecent shell-init' "$f" 2>/dev/null; then
            echo "lsrecent: shell integration already present in $f"
            return 0
        fi
    done
    {
        echo ""
        echo "# lsrecent shell integration"
        echo 'eval "$(lsrecent shell-init)"'
    } >> ~/.bashrc
    echo "lsrecent: added shell integration to ~/.bashrc"
    echo "lsrecent: run \`source ~/.bashrc\` or open a new terminal"
}

cmd_shell_init() {
    # Exported, not just set: the binary is a child process, and this is how it
    # knows which vintage of the functions below is calling it. See
    # stale_integration_notice.
    printf 'export LSRECENT_SHELL=%s\n' "$VERSION"
    cat <<'EOF'
# Clear any alias that shadows a name defined below as a function. In an
# interactive shell aliases are expanded before the parser sees `name()`, so a
# leftover alias turns the definition into a syntax error and eval abandons the
# rest of the integration — which looks like lsrecent half-working rather than a
# name clash. Versions up to 1.1.1 shipped lsrepos and lstoday as aliases, so
# re-sourcing in a shell of that vintage hit exactly this.
unalias ls lsreg lsrepos lsrp lsrt lsry lstoday lsyesterday 2>/dev/null

alias lsr='lsrecent'
alias lsr-add='lsrecent add'
alias lsr-remove='lsrecent remove'
alias lsr-edit='lsrecent edit'

# Escape hatch: plain `ls`, even in a directory where the grouped view is the
# default. Takes the same arguments and colours as the real thing.
lsreg() {
    command ls --color=auto "$@"
}

# Typing a number at the *later* prompt — after the listing's own prompt has been
# answered or dismissed — cds into that entry too. The numbers have to be real
# shell functions defined in *this* shell: `command_not_found_handle` is run in a
# forked subshell, so a cd from there is lost when it exits. That in turn is why
# the grouped views are functions rather than aliases — they rebind after printing,
# so the numbers on screen are always the current ones.
__lsrecent_bound=()
__lsrecent_bind_numbers() {
    (( ${#__lsrecent_bound[@]} )) && unset -f "${__lsrecent_bound[@]}" 2>/dev/null
    __lsrecent_bound=()
    local map="${XDG_DATA_HOME:-$HOME/.local/share}/lsrecent/last-list"
    [[ -f $map ]] || return 0
    # One eval for the whole map, not one per number: the map covers every repo in
    # the ranking, not just the screenful that was printed, so this is a couple of
    # hundred definitions on a listing rather than twenty.
    local n defs=""
    while IFS=$'\t' read -r n _; do
        [[ $n =~ ^[0-9]+$ ]] || continue
        defs+="$n() { __lsrecent_jump $n; }
"
        __lsrecent_bound+=("$n")
    done < "$map"
    [[ -n $defs ]] && eval "$defs"
    return 0
}

__lsrecent_jump() {
    local d
    d=$(lsrecent path "$1") || return 1
    [[ -n $d ]] && cd "$d"
}

# Every listing goes through here, so every listing is interactive: the binary
# prints, prompts, and writes the chosen path to $LSRECENT_CD_FILE, and this
# function — running in your shell, unlike the binary — does the cd.
#
# COLUMNS and LINES are set by interactive bash but not exported, so they are
# passed through explicitly; otherwise the binary has to fork `tput` to size the
# listing and its row budget. The reply file is named after this shell's PID, so
# two terminals listing at the same time cannot read each other's answer, and it
# is a fixed name rather than `mktemp` so the hot path stays fork-free.
__lsrecent_list() {
    local f="$__lsrecent_state/cd.$$" rc d
    rm -f "$f" 2>/dev/null
    COLUMNS="${COLUMNS:-}" LINES="${LINES:-}" LSRECENT_CD_FILE="$f" lsrecent "$@"
    rc=$?
    (( rc == 0 )) && __lsrecent_bind_numbers
    if [[ -s $f ]]; then
        d=$(<"$f")
        rm -f "$f" 2>/dev/null
        [[ -d $d ]] && cd "$d"
    fi
    return $rc
}

lsrepos()     { __lsrecent_list repos "$@"; }
lstoday()     { __lsrecent_list today "$@"; }
lsyesterday() { __lsrecent_list yesterday "$@"; }

ls() {
    if (( $# == 0 )) && [[ -t 1 ]] && lsrecent check 2>/dev/null; then
        __lsrecent_list
    else
        command ls --color=auto "$@"
    fi
}

# Pick a repo and cd into it. `lsrp` = all repos, `lsrt` = today's, `lsry` =
# yesterday's.
lsrp() {
    local d
    d=$(lsrecent pick "$@") && [[ -n "$d" ]] && cd "$d"
}
lsrt() {
    lsrp --today "$@"
}
lsry() {
    lsrp --yesterday "$@"
}

# Visit logging. Deliberately inline rather than a call into the binary: this
# runs on every prompt, so it must not fork. The binary's `lsrecent visit` is
# the equivalent for non-bash shells.
__lsrecent_state="${XDG_DATA_HOME:-$HOME/.local/share}/lsrecent"
[[ -d $__lsrecent_state ]] || mkdir -p "$__lsrecent_state" 2>/dev/null
__lsrecent_last=""
__lsrecent_visit() {
    [[ $PWD == "$__lsrecent_last" ]] && return
    __lsrecent_last=$PWD
    [[ -e $PWD/.git ]] || return
    printf '%s\t%s\n' "${EPOCHSECONDS:-$(date +%s)}" "$PWD" \
        >> "$__lsrecent_state/opened.log" 2>/dev/null
}
if [[ ${PROMPT_COMMAND@a} == *a* ]]; then
    __lsrecent_found=0
    for __lsrecent_pc in "${PROMPT_COMMAND[@]}"; do
        [[ $__lsrecent_pc == *__lsrecent_visit* ]] && __lsrecent_found=1
    done
    (( __lsrecent_found )) || PROMPT_COMMAND=(__lsrecent_visit "${PROMPT_COMMAND[@]}")
    unset __lsrecent_found __lsrecent_pc
else
    case "$PROMPT_COMMAND" in
        *__lsrecent_visit*) ;;
        *) PROMPT_COMMAND="__lsrecent_visit${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
    esac
fi
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

# Before anything reads an LSRECENT_* variable, and before the command is known,
# because `ls` in an override directory arrives here with no command at all.
load_settings
# A broken line in the file is said out loud on every run until it is fixed —
# except on the two paths that must stay silent. `check` is called by the ls
# wrapper on every prompt in every shell, and `visit` on every directory change:
# a warning there would not be a warning, it would be the shell being unusable.
# Both ignore settings entirely, so there is nothing lost by staying quiet.
case "${1:-}" in
    check|visit) ;;
    *)           settings_complain ;;
esac

case "${1:-}" in
    add)         cmd_add "${2:-}" ;;
    remove|rm)   cmd_remove "${2:-}" ;;
    list)        cmd_list ;;
    check)       cmd_check "${2:-}" ;;
    edit)        cmd_edit ;;
    config)      shift; cmd_config "$@" ;;
    visit)       cmd_visit "${2:-}" ;;
    prune)       load_visits; cmd_prune ;;
    noise)       shift; cmd_noise "$@" ;;
    repos)       shift; cmd_repos "$@" ;;
    today)       shift; cmd_repos --today "$@" ;;
    yesterday|yest) shift; cmd_repos --yesterday "$@" ;;
    pick)        shift; cmd_pick "$@" ;;
    path)        cmd_path "${2:-}" ;;
    shell-init)  cmd_shell_init ;;
    shell-install) cmd_shell_install ;;
    # exec, not a background launch: run from a terminal this is a foreground app
    # like any other, and the desktop entry calls lsrecent-gui directly anyway.
    gui)         command -v lsrecent-gui >/dev/null 2>&1 \
                     || die "lsrecent-gui is not installed (needs python3-pyqt6)"
                 shift; exec lsrecent-gui "$@" ;;
    # Reports the shell half as well as the binary, because "the numbers don't do
    # anything" is answered by comparing the two and nothing else can show them.
    -v|--version|version)
        case "${LSRECENT_SHELL:-}" in
            "$VERSION") echo "lsrecent $VERSION (shell integration: loaded)" ;;
            '')         echo "lsrecent $VERSION (shell integration: not loaded in this shell)" ;;
            *)          echo "lsrecent $VERSION (shell integration: $LSRECENT_SHELL — stale, run \`source ~/.bashrc\`)" ;;
        esac
        ;;
    -h|--help|help)
        # The header comment block, minus the shebang, is the help text. Bounded by
        # the first line that is not a comment rather than a fixed line range, so
        # editing the header cannot silently truncate --help.
        awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
        ;;
    *)           cmd_show "${1:-}" ;;
esac
